+/* A named key is kept in the registry, in the user's hive or with NCRYPT_MACHINE_KEY_FLAG the machine's, as the
+ * private key blob BCrypt exports, so that the program finds it again the next time it runs. Windows keeps such
+ * keys in files of its own under Microsoft\Crypto\Keys; without them the Epic Games Launcher, which binds the
+ * player's sign-in to a key of its own, made a new key at every start and the server refused the saved sign-in
+ * (invalid_dpop_proof). */
+static const WCHAR keys_path[] = L"Software\\Wine\\NCrypt\\Keys";
+
+static HKEY open_key_entry(const WCHAR *name, DWORD flags, BOOL create)
+{
+    HKEY root = (flags & NCRYPT_MACHINE_KEY_FLAG) ? HKEY_LOCAL_MACHINE : HKEY_CURRENT_USER, store, entry = NULL;
+    WCHAR *entry_name, *p;
+    LSTATUS ret;
+
+    /* A backslash would make a subkey of the name. */
+    if (!(entry_name = wcsdup(name))) return NULL;
+    for (p = entry_name; *p; p++) if (*p == '\\') *p = '/';
+
+    if (create) ret = RegCreateKeyExW(root, keys_path, 0, NULL, 0, KEY_ALL_ACCESS, NULL, &store, NULL);
+    else ret = RegOpenKeyExW(root, keys_path, 0, KEY_ALL_ACCESS, &store);
+    if (!ret)
+    {
+        if (create) RegCreateKeyExW(store, entry_name, 0, NULL, 0, KEY_ALL_ACCESS, NULL, &entry, NULL);
+        else RegOpenKeyExW(store, entry_name, 0, KEY_ALL_ACCESS, &entry);
+        RegCloseKey(store);
+    }
+    free(entry_name);
+    return entry;
+}
+
+static BOOL key_entry_exists(const WCHAR *name, DWORD flags)
+{
+    HKEY entry = open_key_entry(name, flags, FALSE);
+    if (entry) RegCloseKey(entry);
+    return entry != NULL;
+}
+
+static const WCHAR *private_blob_type(enum algid algid)
+{
+    return algid == RSA ? BCRYPT_RSAFULLPRIVATE_BLOB : BCRYPT_ECCPRIVATE_BLOB;
+}
+
+static SECURITY_STATUS save_persisted_key(struct object *object)
+{
+    const WCHAR *algorithm = object->key.algid == RSA ? BCRYPT_RSA_ALGORITHM : BCRYPT_ECDSA_P256_ALGORITHM;
+    const WCHAR *type = private_blob_type(object->key.algid);
+    SECURITY_STATUS ret = ERROR_SUCCESS;
+    NTSTATUS status;
+    ULONG size;
+    BYTE *blob;
+    HKEY entry;
+
+    if ((status = BCryptExportKey(object->key.bcrypt_key, NULL, type, NULL, 0, &size, 0))) return map_ntstatus(status);
+    if (!(blob = malloc(size))) return NTE_NO_MEMORY;
+    if ((status = BCryptExportKey(object->key.bcrypt_key, NULL, type, blob, size, &size, 0)))
+        ret = map_ntstatus(status);
+    else if (!(entry = open_key_entry(object->key.name, object->key.flags, TRUE)))
+        ret = NTE_FAIL;
+    else
+    {
+        if (RegSetValueExW(entry, L"Algorithm", 0, REG_SZ, (const BYTE *)algorithm,
+                           (wcslen(algorithm) + 1) * sizeof(WCHAR)) ||
+            RegSetValueExW(entry, L"Blob", 0, REG_BINARY, blob, size))
+            ret = NTE_FAIL;
+        RegCloseKey(entry);
+    }
+    SecureZeroMemory(blob, size);
+    free(blob);
+    return ret;
+}
+
+static SECURITY_STATUS set_key_name(struct object *object, const WCHAR *name, DWORD flags)
+{
+    if (!(object->key.name = wcsdup(name))) return NTE_NO_MEMORY;
+    object->key.flags = flags & NCRYPT_MACHINE_KEY_FLAG;
+    return set_object_property(object, NCRYPT_NAME_PROPERTY, (BYTE *)name, (wcslen(name) + 1) * sizeof(WCHAR));
+}
+
 SECURITY_STATUS WINAPI NCryptCreatePersistedKey(NCRYPT_PROV_HANDLE provider, NCRYPT_KEY_HANDLE *key,
                                                 const WCHAR *algid, const WCHAR *name, DWORD keyspec, DWORD flags)
 {
@@ -188,7 +266,7 @@
 
     if (!provider) return NTE_INVALID_HANDLE;
     if (!algid) return HRESULT_FROM_WIN32(RPC_X_NULL_REF_POINTER);
-    if (name) FIXME("Persistent keys are not supported\n");
+    if (name && !(flags & NCRYPT_OVERWRITE_KEY_FLAG) && key_entry_exists(name, flags)) return NTE_EXISTS;
 
     if (!lstrcmpiW(algid, BCRYPT_RSA_ALGORITHM))
     {
@@ -236,6 +314,12 @@
         return NTE_NOT_SUPPORTED;
     }
 
+    if (name && set_key_name(object, name, flags))
+    {
+        NCryptFreeObject((NCRYPT_HANDLE)object);
+        return NTE_NO_MEMORY;
+    }
+
     *key = (NCRYPT_KEY_HANDLE)object;
     return ERROR_SUCCESS;
 }
@@ -250,8 +334,27 @@
 
 SECURITY_STATUS WINAPI NCryptDeleteKey(NCRYPT_KEY_HANDLE key, DWORD flags)
 {
-    FIXME("(%#Ix, %#lx): stub\n", key, flags);
-    return NTE_NOT_SUPPORTED;
+    struct object *object = (struct object *)key;
+
+    TRACE("(%#Ix, %#lx)\n", key, flags);
+
+    if (!object || object->type != KEY) return NTE_INVALID_HANDLE;
+    if (object->key.name)
+    {
+        HKEY root = (object->key.flags & NCRYPT_MACHINE_KEY_FLAG) ? HKEY_LOCAL_MACHINE : HKEY_CURRENT_USER, store;
+        WCHAR *entry_name, *p;
+
+        if (!(entry_name = wcsdup(object->key.name))) return NTE_NO_MEMORY;
+        for (p = entry_name; *p; p++) if (*p == '\\') *p = '/';
+        if (!RegOpenKeyExW(root, keys_path, 0, KEY_ALL_ACCESS, &store))
+        {
+            RegDeleteKeyW(store, entry_name);
+            RegCloseKey(store);
+        }
+        free(entry_name);
+    }
+    /* As on Windows, the handle is freed with the key. */
+    return NCryptFreeObject(key);
 }
 
 SECURITY_STATUS WINAPI NCryptEncrypt(NCRYPT_KEY_HANDLE key, BYTE *input, DWORD insize, void *padding,
@@ -322,6 +425,7 @@
         return map_ntstatus(status);
     }
 
+    if (object->key.name) return save_persisted_key(object);
     return ERROR_SUCCESS;
 }
 
@@ -333,6 +437,7 @@
 
 static SECURITY_STATUS free_key_object(struct key *key)
 {
+    free(key->name);
     return map_ntstatus( BCryptDestroyKey(key->bcrypt_key) );
 }
 
@@ -551,8 +656,72 @@
 SECURITY_STATUS WINAPI NCryptOpenKey(NCRYPT_PROV_HANDLE provider, NCRYPT_KEY_HANDLE *key,
                                      const WCHAR *name, DWORD keyspec, DWORD flags)
 {
-    FIXME("(%#Ix, %p, %s, %#lx, %#lx): stub\n", provider, key, wine_dbgstr_w(name), keyspec, flags);
-    return NTE_NOT_SUPPORTED;
+    WCHAR algorithm[32];
+    DWORD size, type, bitlen;
+    SECURITY_STATUS ret;
+    struct object *object;
+    NTSTATUS status;
+    BYTE *blob;
+    HKEY entry;
+
+    TRACE("(%#Ix, %p, %s, %#lx, %#lx)\n", provider, key, wine_dbgstr_w(name), keyspec, flags);
+
+    if (!provider) return NTE_INVALID_HANDLE;
+    if (!key || !name) return NTE_INVALID_PARAMETER;
+    if (!(entry = open_key_entry(name, flags, FALSE))) return NTE_BAD_KEYSET;
+
+    size = sizeof(algorithm);
+    if (RegQueryValueExW(entry, L"Algorithm", NULL, &type, (BYTE *)algorithm, &size) || type != REG_SZ ||
+        RegQueryValueExW(entry, L"Blob", NULL, &type, NULL, &size) || type != REG_BINARY || !(blob = malloc(size)))
+    {
+        RegCloseKey(entry);
+        return NTE_BAD_KEYSET;
+    }
+    RegQueryValueExW(entry, L"Blob", NULL, NULL, blob, &size);
+    RegCloseKey(entry);
+
+    if (!lstrcmpiW(algorithm, BCRYPT_RSA_ALGORITHM) && size >= sizeof(BCRYPT_RSAKEY_BLOB))
+    {
+        object = create_key_object(RSA, provider);
+        bitlen = ((BCRYPT_RSAKEY_BLOB *)blob)->BitLength;
+    }
+    else if (!lstrcmpiW(algorithm, BCRYPT_ECDSA_P256_ALGORITHM))
+    {
+        object = create_key_object(ECDSA_P256, provider);
+        bitlen = 256;
+    }
+    else
+    {
+        FIXME("Algorithm not handled %s\n", wine_dbgstr_w(algorithm));
+        free(blob);
+        return NTE_NOT_SUPPORTED;
+    }
+    if (!object)
+    {
+        free(blob);
+        return NTE_NO_MEMORY;
+    }
+
+    status = BCryptImportKeyPair(object->key.algid == RSA ? BCRYPT_RSA_ALG_HANDLE : BCRYPT_ECDSA_P256_ALG_HANDLE,
+                                 NULL, private_blob_type(object->key.algid), &object->key.bcrypt_key, blob, size, 0);
+    SecureZeroMemory(blob, size);
+    free(blob);
+    if (status)
+    {
+        WARN("Error importing key %s: %#lx\n", wine_dbgstr_w(name), status);
+        NCryptFreeObject((NCRYPT_HANDLE)object);
+        return map_ntstatus(status);
+    }
+    set_object_property(object, NCRYPT_LENGTH_PROPERTY, (BYTE *)&bitlen, sizeof(bitlen));
+    set_object_property(object, BCRYPT_PUBLIC_KEY_LENGTH, (BYTE *)&bitlen, sizeof(bitlen));
+    if ((ret = set_key_name(object, name, flags)))
+    {
+        NCryptFreeObject((NCRYPT_HANDLE)object);
+        return ret;
+    }
+
+    *key = (NCRYPT_KEY_HANDLE)object;
+    return ERROR_SUCCESS;
 }
 
 SECURITY_STATUS WINAPI NCryptOpenStorageProvider(NCRYPT_PROV_HANDLE *provider, const WCHAR *name, DWORD flags)
