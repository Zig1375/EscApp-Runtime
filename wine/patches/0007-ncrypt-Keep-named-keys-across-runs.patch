+static void test_named_key(void)
+{
+    static const WCHAR name[] = L"wine ncrypt test key";
+    NCRYPT_PROV_HANDLE prov;
+    NCRYPT_KEY_HANDLE key, opened;
+    SECURITY_STATUS ret;
+    BYTE hash[32] = {1, 2, 3}, public1[128], public2[128], signature[128], name_property[64];
+    DWORD size1, size2, signature_size, size;
+
+    ret = NCryptOpenStorageProvider(&prov, NULL, 0);
+    ok(ret == ERROR_SUCCESS, "got %#lx\n", ret);
+
+    /* left over from an earlier run */
+    if (NCryptOpenKey(prov, &key, name, 0, 0) == ERROR_SUCCESS) NCryptDeleteKey(key, 0);
+
+    ret = NCryptOpenKey(prov, &key, name, 0, 0);
+    ok(ret == NTE_BAD_KEYSET, "got %#lx\n", ret);
+
+    ret = NCryptCreatePersistedKey(prov, &key, BCRYPT_ECDSA_P256_ALGORITHM, name, 0, 0);
+    ok(ret == ERROR_SUCCESS, "got %#lx\n", ret);
+    ret = NCryptFinalizeKey(key, 0);
+    ok(ret == ERROR_SUCCESS, "got %#lx\n", ret);
+    ret = NCryptExportKey(key, 0, BCRYPT_ECCPUBLIC_BLOB, NULL, public1, sizeof(public1), &size1, 0);
+    ok(ret == ERROR_SUCCESS, "got %#lx\n", ret);
+    ret = NCryptSignHash(key, NULL, hash, sizeof(hash), signature, sizeof(signature), &signature_size, 0);
+    ok(ret == ERROR_SUCCESS, "got %#lx\n", ret);
+    NCryptFreeObject(key);
+
+    ret = NCryptCreatePersistedKey(prov, &key, BCRYPT_ECDSA_P256_ALGORITHM, name, 0, 0);
+    ok(ret == NTE_EXISTS, "got %#lx\n", ret);
+
+    ret = NCryptOpenKey(prov, &opened, name, 0, 0);
+    ok(ret == ERROR_SUCCESS, "got %#lx\n", ret);
+    ret = NCryptGetProperty(opened, NCRYPT_NAME_PROPERTY, name_property, sizeof(name_property), &size, 0);
+    ok(ret == ERROR_SUCCESS, "got %#lx\n", ret);
+    ok(!lstrcmpW((WCHAR *)name_property, name), "got %s\n", wine_dbgstr_w((WCHAR *)name_property));
+    ret = NCryptExportKey(opened, 0, BCRYPT_ECCPUBLIC_BLOB, NULL, public2, sizeof(public2), &size2, 0);
+    ok(ret == ERROR_SUCCESS, "got %#lx\n", ret);
+    ok(size1 == size2 && !memcmp(public1, public2, size1), "opened a different key\n");
+    ret = NCryptVerifySignature(opened, NULL, hash, sizeof(hash), signature, signature_size, 0);
+    ok(ret == ERROR_SUCCESS, "got %#lx\n", ret);
+
+    ret = NCryptDeleteKey(opened, 0);
+    ok(ret == ERROR_SUCCESS, "got %#lx\n", ret);
+    ret = NCryptOpenKey(prov, &key, name, 0, 0);
+    ok(ret == NTE_BAD_KEYSET, "got %#lx\n", ret);
+
+    NCryptFreeObject(prov);
+}
+
