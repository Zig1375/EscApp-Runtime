ntdll: Let D3DMetal run its macOS code from Windows threads.

Apple's D3DMetal is split into Windows DLLs (d3d12, dxgi, d3d11, d3d10) and a macOS
library (libd3dshared.dylib), and the two call each other directly: dxgi.dll gives
the macOS side callbacks for events, semaphores, threads, windows and the registry,
and starts threads whose Windows entry point calls straight into the macOS library.
That code then runs with the %gs base Windows code has. Since Wine on macOS makes
the TEB the %gs base while Windows code runs, macOS functions there read their
thread data from the TEB: pthread_setname_np found a NULL pthread_self() and every
Direct3D 12 game crashed at start.

With WINEMACSHAREDTSD=1, Windows code runs with the macOS thread data as its %gs
base too. Windows code reads two TEB fields through %gs directly, the TEB itself
(%gs:0x30) and the TLS array (%gs:0x58); both get a copy in the macOS thread data,
in slots macOS leaves alone (6 is pointer munging, unused under Rosetta; 11 is
ttyname's buffer). The loader keeps the TLS copy current for every thread. Slot 12
(%gs:0x60, the PEB) is localtime's buffer, which overwrote the PEB when it was used,
so Wine's own code reads the PEB through the TEB instead, as it now does for the
other thread data its dispatchers read through %gs. The %gs base for Windows code is
kept per thread (pe_tsd_base), the TEB unless the setting is on, so nothing changes
without it. EscApp sets it only for games running on D3DMetal, since Windows code
then can't read other TEB fields through %gs.

Written for EscApp against Wine 11.20. Like the code it changes, this patch is
licensed under the GNU LGPL 2.1 or later.

diff --git a/dlls/ntdll/loader.c b/dlls/ntdll/loader.c
--- a/dlls/ntdll/loader.c
+++ b/dlls/ntdll/loader.c
@@ -1334,6 +1334,23 @@
 }
 
 /*************************************************************************
+ *		set_tls_pointer
+ *
+ * Sets a thread's TLS array, and on macOS also its copy in the %gs base Windows code runs with, when that is the
+ * macOS thread data rather than the TEB (WINEMACSHAREDTSD): Windows code reads the array at %gs:0x58.
+ */
+static void set_tls_pointer( TEB *teb, void **pointers )
+{
+    teb->ThreadLocalStoragePointer = pointers;
+#ifdef __x86_64__
+    {
+        void **pe_tsd_base = *(void ***)((char *)teb + 0x348);  /* amd64_thread_data()->pe_tsd_base */
+        if (pe_tsd_base && pe_tsd_base != (void **)teb) pe_tsd_base[11] = pointers;
+    }
+#endif
+}
+
+/*************************************************************************
  *		alloc_tls_slot
  *
  * Allocate a TLS slot for a newly-loaded module.
@@ -1403,7 +1420,7 @@
 
             if (!new) return FALSE;
             if (old) memcpy( new, old, old_module_count * sizeof(*new) );
-            teb->ThreadLocalStoragePointer = new;
+            set_tls_pointer( teb, new );
             TRACE( "thread %04lx tls block %p -> %p\n", HandleToULong(teb->ClientId.UniqueThread), old, new );
             /* FIXME: can't free old block here, should be freed at thread exit */
         }
@@ -1648,7 +1665,7 @@
 
         TRACE( "slot %u: %u/%lu bytes at %p\n", i, size, dir->SizeOfZeroFill, pointers[i] );
     }
-    NtCurrentTeb()->ThreadLocalStoragePointer = pointers;
+    set_tls_pointer( NtCurrentTeb(), pointers );
     return STATUS_SUCCESS;
 }
 
@@ -4007,7 +4024,7 @@
     RtlAcquirePebLock();
     if ((pointers = NtCurrentTeb()->ThreadLocalStoragePointer))
     {
-        NtCurrentTeb()->ThreadLocalStoragePointer = NULL;
+        set_tls_pointer( NtCurrentTeb(), NULL );
         for (i = 0; i < tls_module_count; i++) RtlFreeHeap( GetProcessHeap(), 0, pointers[i] );
         RtlFreeHeap( GetProcessHeap(), 0, pointers );
     }
