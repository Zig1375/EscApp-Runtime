                    "syscall\n\t"
@@ -2822,6 +2835,12 @@
 
     __asm__( "movw %%cs,%0" : "=m" (cs64_sel) );
     __asm__( "movw %%ss,%0" : "=m" (ds64_sel) );
+#ifdef __APPLE__
+    {
+        const char *shared = getenv( "WINEMACSHAREDTSD" );
+        shared_tsd_base = shared && atoi( shared );
+    }
+#endif
 
     if (wow_teb)
     {
@@ -2920,6 +2939,17 @@
     sysarch( X86_64_SET_GSBASE, &teb );
 #elif defined (__APPLE__)
     thread_data->pthread_teb = mac_thread_gsbase();
+    thread_data->pe_tsd_base = teb;
+    if (shared_tsd_base)
+    {
+        /* Windows code finds its TEB at %gs:0x30 and its TLS array at %gs:0x58. Both slots are free in the
+         * macOS thread data (6: pointer munging, unused under Rosetta; 11: ttyname's buffer); the loader keeps
+         * slot 11 current (set_tls_pointer). */
+        void **tsd = thread_data->pthread_teb;
+        tsd[6] = teb;
+        tsd[11] = teb->ThreadLocalStoragePointer;
+        thread_data->pe_tsd_base = tsd;
+    }
 #else
 # error Please define setting %gs for your architecture
 #endif
