diff --git a/dlls/ntdll/unix/signal_x86_64.c b/dlls/ntdll/unix/signal_x86_64.c
--- a/dlls/ntdll/unix/signal_x86_64.c
+++ b/dlls/ntdll/unix/signal_x86_64.c
@@ -94,6 +94,17 @@
 static USHORT ds64_sel;  /* selector for %ds/%es/%ss in 64-bit mode */
 static USHORT fs32_sel;  /* selector for %fs in 32-bit mode */
 
+#ifdef __APPLE__
+/* Apple's D3DMetal calls between its Windows DLLs and its macOS library directly, without going through
+ * Wine's dispatchers, so its macOS code runs with whatever %gs base Windows code has. With the TEB as base
+ * (Wine's default), macOS functions read their thread data from the TEB: pthread_setname_np found a NULL
+ * pthread_self() and every Direct3D 12 game crashed at start. WINEMACSHAREDTSD=1 keeps the macOS thread data as
+ * the base while Windows code runs as well, with the two TEB fields Windows code reads through %gs copied into
+ * slots macOS leaves free. EscApp sets it only for D3DMetal, since Windows code then can't read other TEB
+ * fields through %gs. */
+static BOOL shared_tsd_base;
+#endif
+
 /***********************************************************************
  * signal context platform-specific definitions
  */
@@ -516,6 +527,7 @@
     DWORD                 fs;            /* 0338 WOW TEB selector */
     DWORD                 mxcsr;         /* 033c Unix-side mxcsr register */
     char                  syscall_dispatch; /* 0340 */
+    void                 *pe_tsd_base;   /* 0348 macOS: %gs base while Windows code runs (shared_tsd_base) */
 };
 
 C_ASSERT( sizeof(struct amd64_thread_data) <= sizeof(((struct teb_data *)0)->cpu_data) );
@@ -525,6 +537,7 @@
 C_ASSERT( offsetof( TEB, GdiTebBatch ) + offsetof( struct amd64_thread_data, fs ) == 0x338 );
 C_ASSERT( offsetof( TEB, GdiTebBatch ) + offsetof( struct amd64_thread_data, mxcsr ) == 0x33c );
 C_ASSERT( offsetof( TEB, GdiTebBatch ) + offsetof( struct amd64_thread_data, syscall_dispatch ) == 0x340 );
+C_ASSERT( offsetof( TEB, GdiTebBatch ) + offsetof( struct amd64_thread_data, pe_tsd_base ) == 0x348 );
 
 static inline struct amd64_thread_data *amd64_thread_data( struct thread_data *data )
 {
@@ -825,7 +838,7 @@
 #elif defined __APPLE__
     if (!is_inside_signal_stack( data, (void *)RSP_sig(sigcontext )) &&
         !is_inside_syscall( data, RSP_sig(sigcontext )))
-        _thread_set_tsd_base( (uint64_t)data->teb );
+        _thread_set_tsd_base( (uint64_t)amd64_data->pe_tsd_base );
 #endif
     if (is_16bit( sigcontext )) return;
 #ifdef DS_sig
@@ -1684,7 +1697,7 @@
                    "1:\n\t"
