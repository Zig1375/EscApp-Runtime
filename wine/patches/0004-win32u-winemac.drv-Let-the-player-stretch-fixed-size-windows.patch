+/* display_lock must be held */
+static void touch_source_registry( const struct source *source )
+{
+    char buffer[1024], name[64];
+    KEY_VALUE_PARTIAL_INFORMATION *value = (void *)buffer;
+    WCHAR nameW[64];
+
+    /* other processes reload the display config only when the video key was written after they last read it */
+    snprintf( name, sizeof(name), "\\Device\\Video%u", source->id );
+    if (!query_reg_ascii_value( video_key, name, value, sizeof(buffer) )) return;
+    asciiz_to_unicode( nameW, name );
+    set_reg_value( video_key, nameW, value->Type, value->Data, value->DataLength );
+}
+
+/* Most games with a fixed-size window are too small on a Mac screen, and can't be made bigger: they don't
+ * redraw at another size. When the player resizes such a window (StretchWindows, with EmulateModeset), the
+ * window keeps its size and the emulated display mode shrinks instead, so that the window covers the new raw
+ * rect. Everything else follows from the virt -> raw mapping that EmulateModeset already does for
+ * fullscreen games: surfaces are stretched, the cursor is mapped back, and the game never sees a resize.
+ *
+ * The size the player chose is the target for that window class, kept in the registry: when the game changes
+ * its window size itself (another resolution in its settings, back from fullscreen, the next start), the scale
+ * is fitted to the target again, keeping the game's aspect ratio. A game bigger than the target is shown at its
+ * own size. A display mode the game set itself is never touched. */
+
+struct stretch_target
+{
+    UINT width, height;                     /* raw size of the window the player chose */
+    UINT physical_width, physical_height;   /* raw display size then */
+};
+
+static const char stretch_keyA[] = "Software\\Wine\\EscApp\\Stretch";
+static const WCHAR stretch_modeW[] = {'M','o','d','e',0};
+static const WCHAR stretch_targetW[] = {'T','a','r','g','e','t',0};
+
+static HKEY open_stretch_key( HWND hwnd, BOOL create )
+{
+    WCHAR class_name[256];
+    UNICODE_STRING name = RTL_CONSTANT_STRING( class_name );
+    HKEY root, hkey = 0;
+    INT len;
+
+    if (!(root = reg_create_ascii_key( hkcu_key, stretch_keyA, 0, NULL ))) return 0;
+    if (!hwnd) return root;
+    name.MaximumLength = sizeof(class_name);
+    if ((len = NtUserGetClassName( hwnd, FALSE, &name )) > 0)
+    {
+        for (INT i = 0; i < len; i++) if (class_name[i] == '\\') class_name[i] = '_';
+        hkey = create ? reg_create_key( root, class_name, len * sizeof(WCHAR), 0, NULL )
+                      : reg_open_key( root, class_name, len * sizeof(WCHAR) );
+    }
+    NtClose( root );
+    return hkey;
+}
+
+static BOOL read_stretch_value( HWND hwnd, const WCHAR *name, void *data, UINT size )
+{
+    char buffer[offsetof(KEY_VALUE_PARTIAL_INFORMATION, Data[64])];
+    KEY_VALUE_PARTIAL_INFORMATION *value = (void *)buffer;
+    HKEY hkey;
+    BOOL ret;
+
+    if (!(hkey = open_stretch_key( hwnd, FALSE ))) return FALSE;
+    ret = query_reg_value( hkey, name, value, sizeof(buffer) ) && value->Type == REG_BINARY && value->DataLength == size;
+    if (ret) memcpy( data, value->Data, size );
+    NtClose( hkey );
+    return ret;
+}
+
+static void write_stretch_value( HWND hwnd, const WCHAR *name, const void *data, UINT size )
+{
+    HKEY hkey;
+
+    if (!(hkey = open_stretch_key( hwnd, TRUE ))) return;
+    set_reg_value( hkey, name, REG_BINARY, data, size );
+    NtClose( hkey );
+}
+
+/* display_lock must be held */
+static double source_stretch_scale( struct source *source )
+{
+    UINT num, den;
+    source_virt_to_raw_ratio( source, &num, &den );
+    return (double)num / den;
+}
+
+/* display_lock must be held; is the emulated mode the physical one, or one stretching set? */
+static BOOL source_mode_is_stretch( struct source *source )
+{
+    UINT mode[2];
+
+    if (source->current.dmPelsWidth == source->physical.dmPelsWidth &&
+        source->current.dmPelsHeight == source->physical.dmPelsHeight) return TRUE;
+    return read_stretch_value( 0, stretch_modeW, mode, sizeof(mode) ) &&
+           mode[0] == source->current.dmPelsWidth && mode[1] == source->current.dmPelsHeight;
+}
+
+/* display_lock must be held. Raw window size at scale 1, and the largest scale that keeps it in the work area. */
+static BOOL get_stretch_bounds( struct monitor *monitor, RECT virt, struct ratio dpi, double *width, double *height,
+                                double *max_scale )
+{
+    double scale = source_stretch_scale( monitor->source );
+    RECT raw = map_monitor_rect( monitor, virt, dpi, MDT_DEFAULT, no_dpi, MDT_RAW_DPI ), work = monitor->rc_work;
+
+    if (IsRectEmpty( &raw ) || IsRectEmpty( &work )) return FALSE;
+    *width = (raw.right - raw.left) / scale;
+    *height = (raw.bottom - raw.top) / scale;
+    *max_scale = min( (work.right - work.left) / *width, (work.bottom - work.top) / *height );
+    if (*max_scale < 1) *max_scale = 1;
+    return TRUE;
+}
+
+/* The monitor DPI is dpi * physical / virtual as a ratio of 16-bit numbers (make_ratio), so not every virtual
+ * size works: take the nearest one that reduces far enough. */
+static UINT fit_stretch_size( UINT dpi, UINT physical, double wanted )
+{
+    UINT size = wanted + 0.5;
+
+    for (UINT step = 0; step < 256; step++)
+    {
+        UINT candidates[2] = {size + step, size - step};
+        for (UINT i = 0; i < 2; i++)
+        {
+            UINT d, c = candidates[i];
+            if (!c || c > physical) continue;
+            d = gcd( dpi * physical, c );
+            if ((dpi * physical) / d < 65536 && c / d < 65536) return c;
+        }
+    }
+    return physical;
+}
+
+/* display_lock must be held; scale is raw pixels per game pixel, at least 1 */
+static BOOL set_stretch_scale( struct source *source, double scale )
+{
+    DEVMODEW mode = source->current;
+    UINT width = source->physical.dmPelsWidth, height = source->physical.dmPelsHeight, saved[2];
+    UINT dpi = source->dpi ? source->dpi : system_dpi;
+
+    if (scale > 1)
+    {
+        width = fit_stretch_size( dpi, width, width / scale );
+        height = fit_stretch_size( dpi, height, height / scale );
+    }
+    if (width == source->current.dmPelsWidth && height == source->current.dmPelsHeight) return FALSE;
+
+    TRACE( "mode %ux%u -> %ux%u, scale %.3f\n", (UINT)mode.dmPelsWidth, (UINT)mode.dmPelsHeight, width, height, scale );
+    mode.dmPelsWidth = width;
+    mode.dmPelsHeight = height;
+    if (!source_set_current_settings( source, &mode )) return FALSE;
+    source->current.dmPelsWidth = width;
+    source->current.dmPelsHeight = height;
+    saved[0] = width;
+    saved[1] = height;
+    write_stretch_value( 0, stretch_modeW, saved, sizeof(saved) );
+    touch_source_registry( source );
+    set_winstation_monitors( TRUE );
+    return TRUE;
+}
+
+static struct monitor *lock_stretch_monitor( RECT virt, struct ratio dpi )
+{
+    struct monitor *monitor;
+
+    if (!lock_display_devices( FALSE )) return NULL;
+    if ((monitor = get_monitor_from_rect( virt, MONITOR_DEFAULTTONEAREST, dpi, MDT_DEFAULT )) && monitor->source &&
+        (monitor->source->state_flags & DISPLAY_DEVICE_ATTACHED_TO_DESKTOP))
+        return monitor;
+    unlock_display_devices();
+    return NULL;
+}
+
+static BOOL get_primary_source_mode( DEVMODEW *mode );
+
+static void notify_stretch( BOOL changed )
+{
+    DEVMODEW mode = {.dmSize = sizeof(DEVMODEW)};
+
+    /* the desktop window follows the virtual screen; games get no WM_DISPLAYCHANGE, nothing changed for them */
+    if (changed && get_primary_source_mode( &mode ))
+        send_notify_message( get_desktop_window(), WM_DISPLAYCHANGE, mode.dmBitsPerPel,
+                             MAKELPARAM( mode.dmPelsWidth, mode.dmPelsHeight ), FALSE );
+}
+
+/* The player resized the window to the raw rect: stretch to it and remember it as the target. Returns FALSE if
+ * the window can't be stretched; the size the player asked for is then applied as usual. */
+BOOL stretch_display_for_window( HWND hwnd, RECT raw )
+{
+    struct ratio dpi = get_thread_dpi();
+    double width, height, max_scale, scale, scale_x, scale_y;
+    struct stretch_target target;
+    struct monitor *monitor;
+    struct source *source;
+    BOOL changed = FALSE, has_target = FALSE;
+    RECT virt;
+
+    if (!emulate_modeset || !stretch_windows) return FALSE;
+    if (!get_window_rect( hwnd, &virt, dpi ) || IsRectEmpty( &raw )) return FALSE;
+    if (!(monitor = lock_stretch_monitor( virt, dpi ))) return FALSE;
+    source = monitor->source;
+
+    /* a mode the game set itself stays; the window just keeps its size */
+    if (source_mode_is_stretch( source ) && get_stretch_bounds( monitor, virt, dpi, &width, &height, &max_scale ))
+    {
+        /* the player drags an edge or a corner: follow the side that changed more */
+        scale = source_stretch_scale( source );
+        scale_x = (raw.right - raw.left) / width;
+        scale_y = (raw.bottom - raw.top) / height;
+        scale = (scale_x > scale ? scale_x - scale : scale - scale_x) >= (scale_y > scale ? scale_y - scale : scale - scale_y)
+                ? scale_x : scale_y;
+        scale = max( 1, min( scale, max_scale ) );
+
+        target.width = width * scale + 0.5;
+        target.height = height * scale + 0.5;
+        target.physical_width = source->physical.dmPelsWidth;
+        target.physical_height = source->physical.dmPelsHeight;
+        TRACE( "hwnd %p virt %s raw %s, target %ux%u\n", hwnd, wine_dbgstr_rect( &virt ), wine_dbgstr_rect( &raw ),
+               target.width, target.height );
+        has_target = TRUE;
+        changed = set_stretch_scale( source, scale );
+    }
+    unlock_display_devices();
+
+    if (has_target) write_stretch_value( hwnd, stretch_targetW, &target, sizeof(target) );
+    notify_stretch( changed );
+    return TRUE;
+}
+
+/* The game sized or showed the window itself (virt rect, in dpi): fit the scale to the player's target again.
+ * Returns TRUE if the display mode changed. */
+BOOL restretch_display_for_window( HWND hwnd, RECT virt, struct ratio dpi )
+{
+    double width, height, max_scale, scale = 1;
+    struct stretch_target target;
+    struct monitor *monitor;
+    struct source *source;
+    BOOL changed = FALSE, has_target;
+
+    if (!emulate_modeset || !stretch_windows || IsRectEmpty( &virt )) return FALSE;
+    has_target = read_stretch_value( hwnd, stretch_targetW, &target, sizeof(target) ) &&
+                 target.physical_width && target.physical_height;
+    if (!(monitor = lock_stretch_monitor( virt, dpi ))) return FALSE;
+    source = monitor->source;
+
+    if (source_mode_is_stretch( source ) && get_stretch_bounds( monitor, virt, dpi, &width, &height, &max_scale ))
+    {
+        if (has_target)
+        {
+            /* the target in today's raw pixels, if the display (or Retina mode) changed since */
+            double target_width = (double)target.width * source->physical.dmPelsWidth / target.physical_width;
+            double target_height = (double)target.height * source->physical.dmPelsHeight / target.physical_height;
+            scale = max( 1, min( min( target_width / width, target_height / height ), max_scale ) );
+        }
+        TRACE( "hwnd %p virt %s, scale %.3f\n", hwnd, wine_dbgstr_rect( &virt ), scale );
+        changed = set_stretch_scale( source, scale );
+    }
+    unlock_display_devices();
+
+    notify_stretch( changed );
+    return changed;
+}
