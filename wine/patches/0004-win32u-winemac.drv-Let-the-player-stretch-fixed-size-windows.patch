+/* move a stretched window back on the work area, as far as it fits; returns the offset */
+static POINT keep_on_work_area( RECT *rect, struct ratio dpi )
+{
+    MONITORINFO info = monitor_info_from_rect( *rect, dpi );
+    POINT offset = {0, 0};
+
+    if (rect->right > info.rcWork.right) offset.x = info.rcWork.right - rect->right;
+    if (rect->left + offset.x < info.rcWork.left) offset.x = info.rcWork.left - rect->left;
+    if (rect->bottom > info.rcWork.bottom) offset.y = info.rcWork.bottom - rect->bottom;
+    if (rect->top + offset.y < info.rcWork.top) offset.y = info.rcWork.top - rect->top;
+    OffsetRect( rect, offset.x, offset.y );
+    return offset;
+}
