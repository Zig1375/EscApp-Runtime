+/***********************************************************************
+ *              macdrv_dxmt_update_window
+ *
+ * Win32u keeps only the client surfaces that GL or Vulkan use in step with
+ * their window. The one made for DXMT is updated here, after the window
+ * moved or changed size (or a stretched window changed scale), so that its
+ * Cocoa view, and DXMT's Metal view inside it, cover the client area.
+ */
+void macdrv_dxmt_update_window(HWND hwnd)
+{
+    struct macdrv_client_surface *surface = NULL;
+
+    pthread_mutex_lock(&dxmt_mutex);
+    if (dxmt_surfaces && (surface = (struct macdrv_client_surface *)CFDictionaryGetValue(dxmt_surfaces, hwnd)))
+        client_surface_add_ref(&surface->client);
+    pthread_mutex_unlock(&dxmt_mutex);
+
+    if (surface)
+    {
+        client_surface_present(&surface->client);
+        client_surface_release(&surface->client);
+    }
+}
+
