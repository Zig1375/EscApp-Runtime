ntdll: Log the native stack when a thread Wine didn't create faults.

A fault on a thread without a TEB (on macOS: the Cocoa main thread, or one of Apple's) ends the process with only
"Exception c0000005 in system thread at <address>" in the log. Among Us died four seconds after start in
objc_release on such a thread, and Steam's helpers and Banished died the same way, with nothing saying whose
object was released. Before ending the process, log the native return addresses with their libraries and
symbols, reading the stack through mach_vm_read_overwrite so a broken frame can't fault again.

--- a/dlls/ntdll/unix/thread.c
+++ b/dlls/ntdll/unix/thread.c
@@ -64,7 +64,9 @@
 
 #ifdef __APPLE__
 #include <CoreFoundation/CoreFoundation.h>
+#include <dlfcn.h>
 #include <mach/mach.h>
+#include <mach/mach_vm.h>
 #endif
 #ifdef __FreeBSD__
 #include <sys/thr.h>
@@ -1589,8 +1591,56 @@
     return STATUS_SUCCESS;
 }
 #endif
+
 
+#if defined(__APPLE__) && defined(__x86_64__)
+/* Reads memory of this process without faulting: the thread is already handling a fault. */
+static BOOL read_native_word( ULONG_PTR addr, ULONG_PTR *value )
+{
+    mach_vm_size_t size = sizeof(*value);
+    return !mach_vm_read_overwrite( mach_task_self(), addr, sizeof(*value), (mach_vm_address_t)value, &size ) &&
+           size == sizeof(*value);
+}
 
+static void log_native_frame( const char *what, ULONG_PTR pc )
+{
+    Dl_info info;
+
+    if (dladdr( (void *)pc, &info ) && info.dli_fname)
+    {
+        const char *lib = strrchr( info.dli_fname, '/' );
+        ERR_(seh)( "  %s %p %s`%s+%#lx\n", what, (void *)pc, lib ? lib + 1 : info.dli_fname,
+                   info.dli_sname ? info.dli_sname : "?",
+                   (unsigned long)(pc - (ULONG_PTR)(info.dli_sname ? info.dli_saddr : info.dli_fbase)) );
+    }
+    else ERR_(seh)( "  %s %p\n", what, (void *)pc );
+}
+
+/* A thread Wine didn't create (on macOS: the Cocoa main thread, or one of Apple's own) has no Windows
+ * debugger or handler, and its fault ends the process with only an address in the log. Among Us died four
+ * seconds after start in objc_release on such a thread, and the address alone named no culprit. Log the
+ * native stack, so the log says whose object it was. */
+static void log_system_thread_stack( const CONTEXT *context )
+{
+    ULONG_PTR frame = context->Rbp, next, ret, top;
+    int i;
+
+    log_native_frame( "at", context->Rip );
+    /* A leaf function may not have set up a frame yet: its caller's address is on top of the stack. */
+    if (read_native_word( context->Rsp, &top )) log_native_frame( "sp", top );
+    for (i = 0; i < 48 && frame && !(frame & 7); i++)
+    {
+        if (!read_native_word( frame + 8, &ret ) || !ret) break;
+        log_native_frame( "from", ret );
+        if (!read_native_word( frame, &next ) || next <= frame) break;
+        frame = next;
+    }
+}
+#else
+static void log_system_thread_stack( const CONTEXT *context ) { }
+#endif
+
+
 /**********************************************************************
  *           send_debug_event
  *
@@ -1609,6 +1659,7 @@
     if (!data->teb)
     {
         ERR_(seh)( "Exception %x in system thread at %p\n", rec->ExceptionCode, rec->ExceptionAddress );
+        log_system_thread_stack( context );
         NtTerminateProcess( NtCurrentProcess(), rec->ExceptionCode );
     }
 
