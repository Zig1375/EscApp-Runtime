+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+/* The server owns the region: it creates it, allocates and frees its cells, signals the objects it keeps itself
+ * (process and thread exit, APC alerts), and cleans up after threads that die, including ones killed while
+ * holding an object's lock or waiting. See include/wine/osync.h for the layout and the operations. */
+
+#include "config.h"
+
+#ifdef __APPLE__
+
+#include <assert.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <unistd.h>
+
+#include "ntstatus.h"
+#include "winternl.h"
+
+#include "object.h"
+#include "request.h"
+#include "thread.h"
+
+#define OSYNC_SERVER
+#include "wine/osync.h"
+#include "osync.h"
+
+#define OSYNC_CHUNKS (OSYNC_CELLS / OSYNC_BLOCK_CELLS)
+
+enum chunk_kind { CHUNK_UNUSED, CHUNK_OBJECTS, CHUNK_BLOCK };
+
+static void *region;
+static int region_fd = -1;
+static int enabled = -1;
+static uint32_t next_chunk = 1;                 /* chunk 0 holds the header */
+static unsigned char chunk_kind[OSYNC_CHUNKS];
+static uint32_t free_cells;                     /* object cells, linked through reserved[0] */
+static uint32_t free_blocks;                    /* wait blocks, linked through reserved[0] */
+/* Objects whose last handle was closed while threads still wait on them: as on Windows, a wait keeps its object
+ * alive. They keep working (a mutex among them is still abandoned when its owner dies) until nobody waits. */
+static uint32_t *zombies;
+static unsigned int zombie_count, zombie_size;
+
+struct thread_block
+{
+    struct list  entry;
+    thread_id_t  tid;
+    uint32_t     cell;
+};
+static struct list thread_blocks = LIST_INIT( thread_blocks );
+
+static int is_enabled(void)
+{
+    if (enabled == -1)
+    {
+        const char *env = getenv( "WINEOSYNC" );
+        enabled = env && atoi( env );
+    }
+    return enabled;
+}
+
+/* Never sleeps for good on a lock whose holder died: once the holder's thread is gone, takes the lock over. */
+void osync_server_lock( uint32_t *lock )
+{
+    unsigned int i;
+    uint32_t cur;
+
+    for (i = 0;; i++)
+    {
+        if (osync_cas( lock, 0, OSYNC_SERVER_TID | (i > 64 ? OSYNC_LOCK_CONTENDED : 0) )) return;
+        if (!(cur = osync_load( lock ))) continue;
+        if (i < 64)
+        {
+            osync_relax();
+            continue;
+        }
+        if (i % 16 == 0)
+        {
+            unsigned int error = get_error();
+            struct thread *holder = get_thread_from_id( cur & ~OSYNC_LOCK_CONTENDED );
+            int dead = !holder || holder->state == TERMINATED;
+
+            if (holder) release_object( holder );
+            set_error( error );
+            if (dead)
+            {
+                if (osync_cas( lock, cur, OSYNC_SERVER_TID | OSYNC_LOCK_CONTENDED )) return;
+                continue;
+            }
+        }
+        if (!(cur & OSYNC_LOCK_CONTENDED) && !osync_cas( lock, cur, cur | OSYNC_LOCK_CONTENDED )) continue;
+        os_sync_wait_on_address_with_timeout( lock, cur | OSYNC_LOCK_CONTENDED, 4, OS_SYNC_WAIT_ON_ADDRESS_SHARED,
+                                              OS_CLOCK_MACH_ABSOLUTE_TIME, 1000000 );
+    }
+}
+
+int osync_region_fd(void)
+{
+    char name[32];
+    int fd;
+
+    if (region_fd != -1 || !is_enabled()) return region_fd;
+
+    snprintf( name, sizeof(name), "/wine-osync-%d", (int)getpid() );
+    fd = shm_open( name, O_RDWR | O_CREAT | O_EXCL, 0600 );
+    if (fd != -1) shm_unlink( name );
+    if (fd == -1 || ftruncate( fd, OSYNC_REGION_SIZE ) == -1 ||
+        (region = mmap( NULL, OSYNC_REGION_SIZE, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0 )) == MAP_FAILED)
+    {
+        fprintf( stderr, "wineserver: osync: can't create the shared region, running without it\n" );
+        if (fd != -1) close( fd );
+        region = NULL;
+        enabled = 0;
+        return -1;
+    }
+    fcntl( fd, F_SETFD, FD_CLOEXEC );
+    osync_header( region )->size = OSYNC_REGION_SIZE;
+    osync_header( region )->version = OSYNC_VERSION;
+    osync_store( &osync_header( region )->magic, OSYNC_MAGIC );
+    region_fd = fd;
+    if (debug_level) fprintf( stderr, "wineserver: osync: region ready\n" );
+    return region_fd;
+}
+
+static uint32_t alloc_chunk( enum chunk_kind kind )
+{
+    if (next_chunk >= OSYNC_CHUNKS) return 0;
+    chunk_kind[next_chunk] = kind;
+    return next_chunk++;
+}
+
+static void free_cell( uint32_t cell )
+{
+    struct osync_obj *obj = osync_obj( region, cell );
+    obj->type = OSYNC_FREE;
+    obj->reserved[0] = free_cells;
+    free_cells = cell;
+}
+
+/* frees the destroyed objects nobody waits on any more */
+static void reap_zombies(void)
+{
+    unsigned int i = 0;
+
+    while (i < zombie_count)
+    {
+        struct osync_obj *obj = osync_obj( region, zombies[i] );
+        int empty;
+
+        osync_lock( &obj->lock, OSYNC_SERVER_TID );
+        if ((empty = !obj->head)) obj->type = OSYNC_FREE;
+        osync_unlock( &obj->lock );
+        if (!empty)
+        {
+            i++;
+            continue;
+        }
+        free_cell( zombies[i] );
+        zombies[i] = zombies[--zombie_count];
+    }
+}
+
+static uint32_t alloc_cell(void)
+{
+    uint32_t cell, chunk, i;
+
+    if (!free_cells && zombie_count) reap_zombies();
+    if (!free_cells)
+    {
+        if (!(chunk = alloc_chunk( CHUNK_OBJECTS ))) return 0;
+        for (i = OSYNC_BLOCK_CELLS; i--;) free_cell( chunk * OSYNC_BLOCK_CELLS + i );
+    }
+    cell = free_cells;
+    free_cells = osync_obj( region, cell )->reserved[0];
+    return cell;
+}
+
+unsigned int osync_create( int type, unsigned int state, unsigned int max, unsigned int owner )
+{
+    struct osync_obj *obj;
+    uint32_t cell;
+
+    if (!region || !(cell = alloc_cell())) return 0;
+    obj = osync_obj( region, cell );
+
+    /* a thread holding a stale name may still lock the cell to find out it is stale */
+    osync_lock( &obj->lock, OSYNC_SERVER_TID );
+    obj->gen = obj->gen % OSYNC_GEN_MAX + 1;
+    obj->state = state;
+    obj->max = max;
+    osync_set_owner( obj, owner );
+    obj->abandoned = 0;
+    obj->head = obj->tail = 0;
+    obj->all_waiters = 0;
+    obj->aux = 0;
+    obj->spinners = 0;
+    obj->type = type;
+    osync_unlock( &obj->lock );
+    return (unsigned int)obj->gen << OSYNC_GEN_SHIFT | cell;
+}
+
+void osync_destroy( unsigned int name )
+{
+    uint32_t cell = name & OSYNC_CELL_MASK;
+    struct osync_obj *obj = osync_obj( region, cell );
+    int waited;
+
+    osync_lock( &obj->lock, OSYNC_SERVER_TID );
+    if (!(waited = obj->head != 0)) obj->type = OSYNC_FREE;
+    osync_unlock( &obj->lock );
+
+    if (!waited)
+    {
+        free_cell( cell );
+        return;
+    }
+    if (zombie_count == zombie_size)
+    {
+        unsigned int size = zombie_size ? zombie_size * 2 : 64;
+        uint32_t *ptr = realloc( zombies, size * sizeof(*zombies) );
+        if (!ptr) return;  /* leaked; harmless */
+        zombies = ptr;
+        zombie_size = size;
+    }
+    zombies[zombie_count++] = cell;
+}
+
+void osync_set( unsigned int name, int signaled )
+{
+    osync_event_op( region, name, signaled ? 0 : 1, OSYNC_SERVER_TID, NULL );
+}
+
+void osync_abandon( unsigned int name, thread_id_t tid )
+{
+    struct osync_obj *obj = osync_obj( region, name & OSYNC_CELL_MASK );
+    struct osync_wakes wakes = { 0 };
+    int all = osync_lock_for_signal( region, obj, OSYNC_SERVER_TID );
+
+    if (osync_valid( obj, name ) && osync_owner( obj ) == tid)
+    {
+        osync_set_owner( obj, 0 );
+        obj->state = 0;
+        obj->abandoned = 1;
+        osync_signaled( region, name & OSYNC_CELL_MASK, obj, OSYNC_SERVER_TID, &wakes );
+    }
+    osync_unlock_for_signal( region, obj, all );
+    osync_flush_wakes( &wakes );
+}
+
+/* the wait block a thread waits with; its cell is published in the thread's alert event */
+static struct thread_block *get_thread_block( thread_id_t tid, int create )
+{
+    struct thread_block *tb;
+    struct osync_block *block;
+    uint32_t cell, chunk;
+
+    LIST_FOR_EACH_ENTRY( tb, &thread_blocks, struct thread_block, entry )
+        if (tb->tid == tid) return tb;
+    if (!create) return NULL;
+
+    if (free_blocks)
+    {
+        cell = free_blocks;
+        free_blocks = osync_block( region, cell )->reserved[0];
+    }
+    else if ((chunk = alloc_chunk( CHUNK_BLOCK ))) cell = chunk * OSYNC_BLOCK_CELLS;
+    else return NULL;
+
+    if (!(tb = malloc( sizeof(*tb) )))
+    {
+        osync_block( region, cell )->reserved[0] = free_blocks;
+        free_blocks = cell;
+        return NULL;
+    }
+    block = osync_block( region, cell );
+    memset( block, 0, OSYNC_BLOCK_CELLS * OSYNC_CELL_SIZE );
+    block->tid = tid;
+    tb->tid = tid;
+    tb->cell = cell;
+    list_add_tail( &thread_blocks, &tb->entry );
+    return tb;
+}
+
+unsigned int osync_alert_name( struct thread *thread, unsigned int alert )
+{
+    struct thread_block *tb;
+    struct osync_obj *obj;
+
+    if (!region || !(tb = get_thread_block( thread->id, 1 ))) return 0;
+    obj = osync_obj( region, alert & OSYNC_CELL_MASK );
+    osync_lock( &obj->lock, OSYNC_SERVER_TID );
+    obj->aux = tb->cell;
+    osync_unlock( &obj->lock );
+    return alert;
+}
+
+static void steal_lock( uint32_t *lock, thread_id_t tid )
+{
+    uint32_t cur = osync_load( lock );
+    if (cur && (cur & ~OSYNC_LOCK_CONTENDED) == tid && osync_cas( lock, cur, 0 ))
+        os_sync_wake_by_address_all( lock, 4, OS_SYNC_WAKE_BY_ADDRESS_SHARED );
+}
+
+/* Called when a thread dies, after its mutexes were abandoned. A thread killed in the middle of an operation can
+ * still hold an object's lock, and a thread killed while waiting is still linked into waiter lists. */
+void osync_thread_died( thread_id_t tid )
+{
+    struct thread_block *tb;
+    struct osync_block *block;
+    uint32_t chunk, i;
+
+    if (!region) return;
+
+    steal_lock( &osync_header( region )->all_lock, tid );
+    for (chunk = 1; chunk < next_chunk; chunk++)
+        if (chunk_kind[chunk] == CHUNK_OBJECTS)
+            for (i = 0; i < OSYNC_BLOCK_CELLS; i++)
+                steal_lock( &osync_obj( region, chunk * OSYNC_BLOCK_CELLS + i )->lock, tid );
+
+    if (!(tb = get_thread_block( tid, 0 ))) return;
+    block = osync_block( region, tb->cell );
+    osync_cas( &block->status, OSYNC_WAITING, OSYNC_CANCELLED );
+    osync_pass_on( region, block, osync_load( &block->status ), OSYNC_SERVER_TID );
+    for (i = 0; i < OSYNC_MAX_ENTRIES; i++)
+    {
+        struct osync_entry *entry = &block->entries[i];
+        struct osync_obj *obj;
+
+        if (!(entry->flags & OSYNC_ENTRY_LINKED)) continue;
+        obj = osync_obj( region, entry->obj );
+        osync_lock( &obj->lock, OSYNC_SERVER_TID );
+        osync_unlink( region, obj, entry );
+        osync_unlock( &obj->lock );
+    }
+    block->status = OSYNC_IDLE;
+
+    /* mutexes it owned whose handles are all closed, but that others still wait for */
+    for (i = 0; i < zombie_count; i++)
+    {
+        struct osync_obj *obj = osync_obj( region, zombies[i] );
+        if (obj->type == OSYNC_MUTEX) osync_abandon( obj->gen << OSYNC_GEN_SHIFT | zombies[i], tid );
+    }
+
+    block->reserved[0] = free_blocks;
+    free_blocks = tb->cell;
+    list_remove( &tb->entry );
+    free( tb );
+}
+
+#endif /* __APPLE__ */
