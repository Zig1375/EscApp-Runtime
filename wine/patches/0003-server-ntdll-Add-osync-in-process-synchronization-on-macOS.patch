+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+/* Events, semaphores and mutexes kept in a shared memory region that wineserver creates and every process of the
+ * prefix maps, so that waiting and signalling don't need a server request. This header holds the layout and the
+ * operations; wineserver (with OSYNC_SERVER defined) and ntdll both build them.
+ *
+ * The region is an array of 64-byte cells, referred to by index. Cell 0 is the header. An object is one cell; a
+ * thread's wait block is OSYNC_BLOCK_CELLS cells, aligned to that size. Only the server allocates cells.
+ *
+ * Locking: each object has a lock word holding its owner's thread id. A thread holding one object lock never waits
+ * for another lock, except under the region's WaitAll lock, which must be taken first; so there is no deadlock.
+ *
+ * Waking: a thread that makes an event or semaphore acquirable hands it to waiters directly. It claims a waiter by
+ * switching its wait block's status from OSYNC_WAITING to the result, acquires the object on the waiter's behalf and
+ * wakes that one status word. A waiter giving up (timeout) makes the same switch to OSYNC_CANCELLED, so exactly one
+ * wins. A released mutex is not handed over: it becomes free and one waiter is woken (OSYNC_RETRY) to try to take
+ * it, so running threads aren't held up behind a sleeping one; whoever ends up not taking it wakes the next. A
+ * waiter that lost that race OSYNC_MAX_LOST times gets the next release handed over directly, so nobody starves
+ * behind threads that keep re-taking the mutex. */
+
+#ifndef __WINE_WINE_OSYNC_H
+#define __WINE_WINE_OSYNC_H
+
+#ifdef __APPLE__
+
+#include <stdint.h>
+#include <errno.h>
+#include <time.h>
+#include <os/os_sync_wait_on_address.h>
+
+#define OSYNC_REGION_SIZE   (64 * 1024 * 1024)
+#define OSYNC_CELL_SIZE     64
+#define OSYNC_CELLS         (OSYNC_REGION_SIZE / OSYNC_CELL_SIZE)
+#define OSYNC_BLOCK_CELLS   32          /* a wait block, and the unit the server carves cells from */
+#define OSYNC_MAX_ENTRIES   65          /* MAXIMUM_WAIT_OBJECTS objects plus the APC alert event */
+#define OSYNC_MAGIC         0x4f53594e  /* 'OSYN' */
+#define OSYNC_VERSION       1
+
+/* A process names an object by generation << OSYNC_GEN_SHIFT | cell; the generation changes when a cell is
+ * reused, so a stale name fails instead of reaching the new object. */
+#define OSYNC_GEN_SHIFT     24
+#define OSYNC_CELL_MASK     ((1u << OSYNC_GEN_SHIFT) - 1)
+#define OSYNC_GEN_MAX       127
+
+#define OSYNC_LOCK_CONTENDED 1u         /* thread ids are multiples of 4, so bit 0 is free */
+#define OSYNC_SERVER_TID     0x7ffffff0u
+
+enum osync_type
+{
+    OSYNC_FREE = 0,
+    OSYNC_EVENT_MANUAL,
+    OSYNC_EVENT_AUTO,
+    OSYNC_SEMAPHORE,
+    OSYNC_MUTEX,
+};
+
+/* wait block status */
+#define OSYNC_IDLE          0u
+#define OSYNC_WAITING       1u
+#define OSYNC_CANCELLED     2u
+#define OSYNC_SIGNALED      0x10000u    /* | entry slot */
+#define OSYNC_ABANDONED     0x20000u    /* with OSYNC_SIGNALED: an abandoned mutex was among the acquired objects */
+#define OSYNC_RETRY         0x40000u    /* | slot: a mutex at this slot was released; try to take it */
+#define OSYNC_SLOT_MASK     0xffffu
+
+struct osync_header
+{
+    uint32_t magic;
+    uint32_t version;
+    uint32_t size;
+    uint32_t all_lock;                  /* taken before more than one object lock */
+    uint32_t reserved[12];
+};
+
+struct osync_obj
+{
+    uint32_t lock;                      /* 0, or the holder's thread id | OSYNC_LOCK_CONTENDED */
+    uint16_t type;                      /* enum osync_type */
+    uint16_t gen;
+    uint32_t state;                     /* event: signalled; semaphore: count; mutex: recursion count */
+    uint32_t max;                       /* semaphore: maximum count */
+    uint32_t owner;                     /* mutex: owning thread id, 0 if none (atomic: read without the lock) */
+    uint32_t abandoned;                 /* mutex: its owner died holding it */
+    uint32_t head;                      /* waiter list, entry ids; 0 if empty */
+    uint32_t tail;
+    uint32_t all_waiters;               /* entries of WaitAll waits in the list */
+    uint32_t aux;                       /* a thread's alert event: the cell of its wait block */
+    uint32_t spinners;                  /* waiters spinning on it now (at most one is allowed to) */
+    uint32_t reserved[5];
+};
+
+#define OSYNC_ENTRY_ALL     1           /* part of a WaitAll wait */
+#define OSYNC_ENTRY_LINKED  2
+
+/* An entry's id is its offset in the region divided by 16. */
+struct osync_entry
+{
+    uint32_t next;
+    uint32_t prev;
+    uint32_t obj;                       /* cell */
+    uint16_t slot;                      /* position in the wait */
+    uint16_t flags;
+};
+
+struct osync_block
+{
+    uint32_t status;                    /* OSYNC_IDLE, OSYNC_WAITING, OSYNC_CANCELLED or OSYNC_SIGNALED | ... */
+    uint32_t tid;                       /* thread waiting with this block */
+    uint32_t count;                     /* objects in the current wait, not counting the alert event */
+    uint32_t sleeping;                  /* the waiter is (about to be) asleep in the kernel: wake it */
+    uint32_t lost;                      /* times this wait was woken to retry a mutex and someone else got it */
+    uint32_t reserved[11];
+    struct osync_entry entries[OSYNC_MAX_ENTRIES];
+};
+
+typedef char osync_obj_size_check[sizeof(struct osync_obj) == OSYNC_CELL_SIZE ? 1 : -1];
+typedef char osync_header_size_check[sizeof(struct osync_header) <= OSYNC_CELL_SIZE ? 1 : -1];
+typedef char osync_block_size_check[sizeof(struct osync_block) <= OSYNC_BLOCK_CELLS * OSYNC_CELL_SIZE ? 1 : -1];
+
+static inline struct osync_header *osync_header( void *base )
+{
+    return (struct osync_header *)base;
+}
+
+static inline struct osync_obj *osync_obj( void *base, uint32_t cell )
+{
+    return (struct osync_obj *)((char *)base + (size_t)cell * OSYNC_CELL_SIZE);
+}
+
+static inline struct osync_block *osync_block( void *base, uint32_t cell )
+{
+    return (struct osync_block *)((char *)base + (size_t)cell * OSYNC_CELL_SIZE);
+}
+
+static inline uint32_t osync_entry_id( void *base, struct osync_entry *entry )
+{
+    return (uint32_t)(((char *)entry - (char *)base) / sizeof(struct osync_entry));
+}
+
+static inline struct osync_entry *osync_entry( void *base, uint32_t id )
+{
+    return (struct osync_entry *)((char *)base + (size_t)id * sizeof(struct osync_entry));
+}
+
+static inline struct osync_block *osync_entry_block( void *base, uint32_t id )
+{
+    uint32_t cell = id / (OSYNC_CELL_SIZE / sizeof(struct osync_entry));
+    return osync_block( base, cell & ~(OSYNC_BLOCK_CELLS - 1) );
+}
+
+static inline int osync_cas( uint32_t *ptr, uint32_t expected, uint32_t desired )
+{
+    return __atomic_compare_exchange_n( ptr, &expected, desired, 0, __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST );
+}
+
+static inline uint32_t osync_load( const uint32_t *ptr )
+{
+    return __atomic_load_n( ptr, __ATOMIC_ACQUIRE );
+}
+
+static inline void osync_store( uint32_t *ptr, uint32_t value )
+{
+    __atomic_store_n( ptr, value, __ATOMIC_RELEASE );
+}
+
+static inline void osync_relax(void)
+{
+#if defined(__x86_64__) || defined(__i386__)
+    __asm__ __volatile__( "pause" ::: "memory" );
+#elif defined(__aarch64__)
+    __asm__ __volatile__( "yield" ::: "memory" );
+#endif
+}
+
+/* A waiter spins this long before sleeping: a hand-off that arrives meanwhile costs no system call on either side.
+ * Time-based, since a pause instruction costs next to nothing under Rosetta. */
+#ifndef OSYNC_SPIN_NS
+#define OSYNC_SPIN_NS 2000
+#endif
+
+static inline uint64_t osync_now(void)
+{
+    return clock_gettime_nsec_np( CLOCK_UPTIME_RAW );
+}
+
+/* ---- locks ---------------------------------------------------------------------------------------------- */
+
+#ifdef OSYNC_SERVER
+/* The server never sleeps on a lock held by a dead thread; see server/osync.c. */
+extern void osync_server_lock( uint32_t *lock );
+#endif
+
+static inline void osync_lock( uint32_t *lock, uint32_t me )
+{
+#ifdef OSYNC_SERVER
+    osync_server_lock( lock );
+#else
+    uint32_t cur;
+    int i;
+
+    if (osync_cas( lock, 0, me )) return;
+    for (i = 0; i < 1024; i++)
+    {
+        osync_relax();
+        if (!osync_load( lock ) && osync_cas( lock, 0, me )) return;
+    }
+    for (;;)
+    {
+        /* once contended, take it marked contended: others may still sleep on it */
+        if (!(cur = osync_load( lock )))
+        {
+            if (osync_cas( lock, 0, me | OSYNC_LOCK_CONTENDED )) return;
+            continue;
+        }
+        if (!(cur & OSYNC_LOCK_CONTENDED) && !osync_cas( lock, cur, cur | OSYNC_LOCK_CONTENDED )) continue;
+        os_sync_wait_on_address( lock, cur | OSYNC_LOCK_CONTENDED, 4, OS_SYNC_WAIT_ON_ADDRESS_SHARED );
+    }
+#endif
+}
+
+static inline void osync_unlock( uint32_t *lock )
+{
+    uint32_t old = __atomic_exchange_n( lock, 0, __ATOMIC_SEQ_CST );
+    if (old & OSYNC_LOCK_CONTENDED) os_sync_wake_by_address_any( lock, 4, OS_SYNC_WAKE_BY_ADDRESS_SHARED );
+}
+
+/* Takes an object's lock for an operation that can make it acquirable. Waking WaitAll waiters looks at their other
+ * objects, which needs the WaitAll lock, taken first; returns whether it was. */
+static inline int osync_lock_for_signal( void *base, struct osync_obj *obj, uint32_t me )
+{
+    osync_lock( &obj->lock, me );
+    if (!obj->all_waiters) return 0;
+    osync_unlock( &obj->lock );
+    osync_lock( &osync_header( base )->all_lock, me );
+    osync_lock( &obj->lock, me );
+    return 1;
+}
+
+static inline void osync_unlock_for_signal( void *base, struct osync_obj *obj, int all )
+{
+    osync_unlock( &obj->lock );
+    if (all) osync_unlock( &osync_header( base )->all_lock );
+}
+
+/* ---- object state, under the object's lock -------------------------------------------------------------- */
+
+static inline uint32_t osync_owner( const struct osync_obj *obj )
+{
+    return __atomic_load_n( &obj->owner, __ATOMIC_RELAXED );
+}
+
+static inline void osync_set_owner( struct osync_obj *obj, uint32_t tid )
+{
+    __atomic_store_n( &obj->owner, tid, __ATOMIC_RELEASE );
+}
+
+static inline int osync_can_take( const struct osync_obj *obj, uint32_t tid )
+{
+    switch (obj->type)
+    {
+    case OSYNC_EVENT_MANUAL:
+    case OSYNC_EVENT_AUTO:
+    case OSYNC_SEMAPHORE:
+        return obj->state != 0;
+    case OSYNC_MUTEX:
+        return !osync_owner( obj ) || (osync_owner( obj ) == tid && obj->state < 0x7fffffff);
+    }
+    return 0;
+}
+
+/* whether some thread could take it now */
+static inline int osync_is_signaled( const struct osync_obj *obj )
+{
+    return obj->type == OSYNC_MUTEX ? !osync_owner( obj ) : obj->state != 0;
+}
+
+static inline uint32_t osync_abandoned( const struct osync_obj *obj )
+{
+    return (obj->type == OSYNC_MUTEX && obj->abandoned) ? OSYNC_ABANDONED : 0;
+}
+
+static inline void osync_take( struct osync_obj *obj, uint32_t tid )
+{
+    switch (obj->type)
+    {
+    case OSYNC_EVENT_AUTO:
+        obj->state = 0;
+        break;
+    case OSYNC_SEMAPHORE:
+        obj->state--;
+        break;
+    case OSYNC_MUTEX:
+        if (osync_owner( obj ) == tid) obj->state++;
+        else
+        {
+            osync_set_owner( obj, tid );
+            obj->state = 1;
+        }
+        obj->abandoned = 0;
+        break;
+    }
+}
+
+static inline int osync_claim( struct osync_block *block, uint32_t result )
+{
+    if (!osync_cas( &block->status, OSYNC_WAITING, result )) return 0;
+    return 1;
+}
+
+/* A spinning waiter sees its status change by itself; only a sleeping one needs the system call. The waiter sets
+ * "sleeping" before the kernel compares its status, the waker changed the status before reading "sleeping"; with
+ * both sequentially consistent, at least one of them sees the other's store, so no wakeup is lost. */
+static inline void osync_wake_block( struct osync_block *block )
+{
+    if (__atomic_load_n( &block->sleeping, __ATOMIC_SEQ_CST ))
+        os_sync_wake_by_address_any( &block->status, 4, OS_SYNC_WAKE_BY_ADDRESS_SHARED );
+}
+
+/* Waiters claimed under a lock are woken after it is released, so they don't wake up only to wait for that lock.
+ * Waking late is safe: the claim already decided the outcome, and a waiter that moved on just sees a spurious
+ * wakeup and checks its status again. */
+#define OSYNC_MAX_DEFERRED 64
+
+struct osync_wakes
+{
+    unsigned int count;
+    struct osync_block *blocks[OSYNC_MAX_DEFERRED];
+};
+
+static inline void osync_defer_wake( struct osync_wakes *wakes, struct osync_block *block )
+{
+    if (wakes->count < OSYNC_MAX_DEFERRED) wakes->blocks[wakes->count++] = block;
+    else osync_wake_block( block );
+}
+
+static inline void osync_flush_wakes( struct osync_wakes *wakes )
+{
+    unsigned int i;
+    for (i = 0; i < wakes->count; i++) osync_wake_block( wakes->blocks[i] );
+    wakes->count = 0;
+}
+
+static inline int osync_linked( struct osync_entry *entry )
+{
+    return __atomic_load_n( &entry->flags, __ATOMIC_ACQUIRE ) & OSYNC_ENTRY_LINKED;
+}
+
+static inline void osync_link( void *base, struct osync_obj *obj, struct osync_entry *entry )
+{
+    uint32_t id = osync_entry_id( base, entry );
+    uint16_t flags = entry->flags;
+
+    entry->next = 0;
+    entry->prev = obj->tail;
+    if (obj->tail) osync_entry( base, obj->tail )->next = id;
+    else obj->head = id;
+    obj->tail = id;
+    if (flags & OSYNC_ENTRY_ALL) obj->all_waiters++;
+    __atomic_store_n( &entry->flags, flags | OSYNC_ENTRY_LINKED, __ATOMIC_RELEASE );
+}
+
+/* Once the entry is marked unlinked its waiter may reuse it at once: nothing reads it after that store. */
+static inline void osync_unlink( void *base, struct osync_obj *obj, struct osync_entry *entry )
+{
+    uint16_t flags = entry->flags;
+
+    if (!(flags & OSYNC_ENTRY_LINKED)) return;
+    if (entry->prev) osync_entry( base, entry->prev )->next = entry->next;
+    else obj->head = entry->next;
+    if (entry->next) osync_entry( base, entry->next )->prev = entry->prev;
+    else obj->tail = entry->prev;
+    if (flags & OSYNC_ENTRY_ALL) obj->all_waiters--;
+    __atomic_store_n( &entry->flags, flags & ~OSYNC_ENTRY_LINKED, __ATOMIC_RELEASE );
+}
+
+#ifndef OSYNC_MAX_LOST
+#define OSYNC_MAX_LOST 2
+#endif
+
+/* Hands the object to WaitAny waiters while it is acquirable. A claimed waiter's entry is unlinked here, under
+ * the lock already held, so a single-object waiter has nothing left to do. */
+static inline void osync_wake_any( void *base, struct osync_obj *obj, struct osync_wakes *wakes )
+{
+    int pass;
+
+    /* For a mutex, first to a waiter that keeps losing it (handed over); then, for everything, to waiters still
+     * spinning, who take it without a system call on either side; then to the others. */
+    for (pass = obj->type == OSYNC_MUTEX ? 0 : 1; pass < 3; pass++)
+    {
+        uint32_t id = obj->head, tid;
+
+        while (id && osync_is_signaled( obj ))
+        {
+            struct osync_entry *entry = osync_entry( base, id );
+            struct osync_block *block = osync_entry_block( base, id );
+
+            id = entry->next;
+            if (entry->flags & OSYNC_ENTRY_ALL) continue;
+            if (osync_load( &block->status ) != OSYNC_WAITING) continue;
+            if (pass == 0 && __atomic_load_n( &block->lost, __ATOMIC_RELAXED ) < OSYNC_MAX_LOST) continue;
+            if (pass == 1 && __atomic_load_n( &block->sleeping, __ATOMIC_RELAXED )) continue;
+            tid = block->tid;
+            if (!osync_can_take( obj, tid )) continue;
+            if (obj->type == OSYNC_MUTEX && pass)
+            {
+                if (!osync_claim( block, OSYNC_RETRY | entry->slot )) continue;
+                osync_unlink( base, obj, entry );
+                osync_defer_wake( wakes, block );
+                return;  /* one at a time */
+            }
+            if (osync_claim( block, OSYNC_SIGNALED | osync_abandoned( obj ) | entry->slot ))
+            {
+                osync_take( obj, tid );
+                osync_unlink( base, obj, entry );
+                osync_defer_wake( wakes, block );
+            }
+        }
+    }
+}
+
+/* Hands objects to WaitAll waiters of this object that can now take all of theirs. The caller holds the WaitAll
+ * lock and this object's lock. */
+static inline void osync_wake_all( void *base, uint32_t cell, struct osync_obj *obj, uint32_t me,
+                                   struct osync_wakes *wakes )
+{
+    uint32_t id = obj->head;
+
+    while (id && obj->all_waiters)
+    {
+        struct osync_entry *entry = osync_entry( base, id );
+        struct osync_block *block = osync_entry_block( base, id );
+        uint32_t i, count, tid, ok = 1, abandoned = 0, cells[OSYNC_MAX_ENTRIES];
+
+        id = entry->next;
+        if (!(entry->flags & OSYNC_ENTRY_ALL)) continue;
+        if (osync_load( &block->status ) != OSYNC_WAITING) continue;
+
+        /* The wait can't end while this entry is linked under our lock; once claimed and unlinked, the block may
+         * be reused at once, so work from copies. */
+        count = block->count;
+        tid = block->tid;
+        for (i = 0; i < count; i++) cells[i] = block->entries[i].obj;
+        for (i = 0; i < count; i++)
+            if (cells[i] != cell) osync_lock( &osync_obj( base, cells[i] )->lock, me );
+        for (i = 0; i < count && ok; i++)
+        {
+            struct osync_obj *other = osync_obj( base, cells[i] );
+            ok = osync_can_take( other, tid );
+            abandoned |= osync_abandoned( other );
+        }
+        if (ok && osync_claim( block, OSYNC_SIGNALED | abandoned ))
+        {
+            for (i = 0; i < count; i++)
+            {
+                struct osync_obj *other = osync_obj( base, cells[i] );
+                osync_take( other, tid );
+                osync_unlink( base, other, &block->entries[i] );
+            }
+            osync_defer_wake( wakes, block );
+        }
+        for (i = 0; i < count; i++)
+            if (cells[i] != cell) osync_unlock( &osync_obj( base, cells[i] )->lock );
+    }
+}
+
+/* After an object became acquirable; under osync_lock_for_signal(). */
+static inline void osync_signaled( void *base, uint32_t cell, struct osync_obj *obj, uint32_t me,
+                                   struct osync_wakes *wakes )
+{
+    if (obj->all_waiters) osync_wake_all( base, cell, obj, me, wakes );
+    osync_wake_any( base, obj, wakes );
+}
+
+/* For the server, when a thread dies: if it had been woken to retry a mutex (OSYNC_RETRY), wake the next waiter in
+ * its place. */
+static inline void osync_pass_on( void *base, struct osync_block *block, uint32_t status, uint32_t me )
+{
+    struct osync_wakes wakes;
+    struct osync_obj *obj;
+    uint32_t cell;
+    int all;
+
+    if (!(status & OSYNC_RETRY)) return;
+    cell = block->entries[status & OSYNC_SLOT_MASK].obj;
+    obj = osync_obj( base, cell );
+    wakes.count = 0;
+    all = osync_lock_for_signal( base, obj, me );
+    if (osync_is_signaled( obj )) osync_signaled( base, cell, obj, me, &wakes );
+    osync_unlock_for_signal( base, obj, all );
+    osync_flush_wakes( &wakes );
+}
+
+/* ---- operations ------------------------------------------------------------------------------------------ */
+
+enum osync_result
+{
+    OSYNC_OK = 0,
+    OSYNC_BAD_HANDLE,                   /* stale name: the object was destroyed */
+    OSYNC_LIMIT,                        /* semaphore or mutex count limit */
+    OSYNC_NOT_OWNED,                    /* releasing a mutex the thread doesn't own */
+};
+
+static inline struct osync_obj *osync_lookup( void *base, uint32_t name )
+{
+    uint32_t cell = name & OSYNC_CELL_MASK;
+    if (!cell || cell >= OSYNC_CELLS) return NULL;
+    return osync_obj( base, cell );
+}
+
+static inline int osync_valid( const struct osync_obj *obj, uint32_t name )
+{
+    return obj->gen == name >> OSYNC_GEN_SHIFT && obj->type != OSYNC_FREE;
+}
+
+/* op: 0 set, 1 reset, 2 pulse */
+static inline enum osync_result osync_event_op( void *base, uint32_t name, int op, uint32_t me, uint32_t *prev )
+{
+    struct osync_obj *obj = osync_lookup( base, name );
+    enum osync_result ret = OSYNC_OK;
+    struct osync_wakes wakes;
+    int all;
+
+    if (!obj) return OSYNC_BAD_HANDLE;
+    wakes.count = 0;
+    all = osync_lock_for_signal( base, obj, me );
+    if (!osync_valid( obj, name )) ret = OSYNC_BAD_HANDLE;
+    else
+    {
+        if (prev) *prev = obj->state;
+        if (op == 1) obj->state = 0;
+        else
+        {
+            obj->state = 1;
+            osync_signaled( base, name & OSYNC_CELL_MASK, obj, me, &wakes );
+            if (op == 2) obj->state = 0;
+        }
+    }
+    osync_unlock_for_signal( base, obj, all );
+    osync_flush_wakes( &wakes );
+    return ret;
+}
+
+static inline enum osync_result osync_release_semaphore( void *base, uint32_t name, uint32_t count, uint32_t me,
+                                                         uint32_t *prev )
+{
+    struct osync_obj *obj = osync_lookup( base, name );
+    enum osync_result ret = OSYNC_OK;
+    struct osync_wakes wakes;
+    int all;
+
+    if (!obj) return OSYNC_BAD_HANDLE;
+    wakes.count = 0;
+    all = osync_lock_for_signal( base, obj, me );
+    if (!osync_valid( obj, name )) ret = OSYNC_BAD_HANDLE;
+    else if (count > obj->max - obj->state) ret = OSYNC_LIMIT;
+    else
+    {
+        if (prev) *prev = obj->state;
+        obj->state += count;
+        osync_signaled( base, name & OSYNC_CELL_MASK, obj, me, &wakes );
+    }
+    osync_unlock_for_signal( base, obj, all );
+    osync_flush_wakes( &wakes );
+    return ret;
+}
+
+/* *prev gets the previous recursion count */
+static inline enum osync_result osync_release_mutex( void *base, uint32_t name, uint32_t me, uint32_t *prev )
+{
+    struct osync_obj *obj = osync_lookup( base, name );
+    enum osync_result ret = OSYNC_OK;
+    struct osync_wakes wakes;
+    int all;
+
+    if (!obj) return OSYNC_BAD_HANDLE;
+    wakes.count = 0;
+    all = osync_lock_for_signal( base, obj, me );
+    if (!osync_valid( obj, name )) ret = OSYNC_BAD_HANDLE;
+    else if (osync_owner( obj ) != me) ret = OSYNC_NOT_OWNED;
+    else
+    {
+        if (prev) *prev = obj->state;
+        if (!--obj->state)
+        {
+            osync_set_owner( obj, 0 );
+            osync_signaled( base, name & OSYNC_CELL_MASK, obj, me, &wakes );
+        }
+    }
+    osync_unlock_for_signal( base, obj, all );
+    osync_flush_wakes( &wakes );
+    return ret;
+}
+
+/* Copies the object's state; for queries. */
+static inline enum osync_result osync_read( void *base, uint32_t name, uint32_t me, struct osync_obj *copy )
+{
+    struct osync_obj *obj = osync_lookup( base, name );
+    enum osync_result ret = OSYNC_OK;
+
+    if (!obj) return OSYNC_BAD_HANDLE;
+    osync_lock( &obj->lock, me );
+    if (!osync_valid( obj, name )) ret = OSYNC_BAD_HANDLE;
+    else *copy = *obj;
+    osync_unlock( &obj->lock );
+    return ret;
+}
+
+/* Waits for objects (cells, not names: the caller validates them). alert: the thread's alert event cell or 0; it
+ * takes slot "count". timeout: OSYNC_INFINITE, or nanoseconds of osync_now() at which to give up. Returns the
+ * block status: OSYNC_CANCELLED on timeout, OSYNC_SIGNALED [| OSYNC_ABANDONED] | slot otherwise; or 0 with
+ * *invalid set for a WaitAll naming an object twice. */
+#define OSYNC_INFINITE (~(uint64_t)0)
+/* spin_obj: the object waited on, for a single-object wait; only one thread at a time spins on an object, so that
+ * a crowd of waiters doesn't take the processors from the thread that would release it. */
+static inline uint32_t osync_sleep( struct osync_block *block, uint64_t deadline, struct osync_obj *spin_obj )
+{
+    uint32_t status = OSYNC_WAITING;
+    unsigned int i;
+    uint64_t spin_end = 0;
+    int spin = !spin_obj || __atomic_add_fetch( &spin_obj->spinners, 1, __ATOMIC_RELAXED ) == 1;
+
+    for (i = 0; spin; i++)
+    {
+        if ((status = osync_load( &block->status )) != OSYNC_WAITING) break;
+        if (!(i & 63))
+        {
+            uint64_t now = osync_now();
+            if (!spin_end) spin_end = now + OSYNC_SPIN_NS;
+            else if (now >= spin_end || now >= deadline) break;
+        }
+        osync_relax();
+    }
+    if (spin_obj) __atomic_sub_fetch( &spin_obj->spinners, 1, __ATOMIC_RELAXED );
+    while ((status = osync_load( &block->status )) == OSYNC_WAITING)
+    {
+        __atomic_store_n( &block->sleeping, 1, __ATOMIC_SEQ_CST );
+        if (deadline == OSYNC_INFINITE)
+            os_sync_wait_on_address( &block->status, OSYNC_WAITING, 4, OS_SYNC_WAIT_ON_ADDRESS_SHARED );
+        else
+        {
+            uint64_t now = osync_now();
+            if (now >= deadline)
+            {
+                if (osync_claim( block, OSYNC_CANCELLED ))
+                {
+                    status = OSYNC_CANCELLED;
+                    break;
+                }
+                continue;   /* claimed meanwhile */
+            }
+            os_sync_wait_on_address_with_timeout( &block->status, OSYNC_WAITING, 4, OS_SYNC_WAIT_ON_ADDRESS_SHARED,
+                                                  OS_CLOCK_MACH_ABSOLUTE_TIME, deadline - now );
+        }
+    }
+    __atomic_store_n( &block->sleeping, 0, __ATOMIC_RELAXED );
+    return status;
+}
+
+/* After OSYNC_RETRY for a mutex: take it if still free. If another thread took it, that thread wakes the next
+ * waiter when it releases it, so the caller may wait again or give up. */
+static inline uint32_t osync_retry( void *base, uint32_t me, uint32_t cell, uint32_t slot )
+{
+    struct osync_obj *obj = osync_obj( base, cell );
+    uint32_t status = 0;
+
+    osync_lock( &obj->lock, me );
+    if (osync_can_take( obj, me ))
+    {
+        status = OSYNC_SIGNALED | osync_abandoned( obj ) | slot;
+        osync_take( obj, me );
+    }
+    osync_unlock( &obj->lock );
+    return status;
+}
+
+static inline uint32_t osync_wait_any( void *base, uint32_t block_cell, uint32_t me, uint32_t count,
+                                       const uint32_t *cells, uint32_t alert, uint64_t deadline )
+{
+    struct osync_block *block = osync_block( base, block_cell );
+    uint32_t i, total = count + (alert ? 1 : 0), linked, status;
+
+    __atomic_store_n( &block->lost, 0, __ATOMIC_RELAXED );
+    for (;;)
+    {
+        /* fast path: something is acquirable already; nobody can claim an idle block */
+        for (i = 0; i < total; i++)
+        {
+            struct osync_obj *obj = osync_obj( base, i < count ? cells[i] : alert );
+            osync_lock( &obj->lock, me );
+            if (osync_can_take( obj, me ))
+            {
+                status = OSYNC_SIGNALED | osync_abandoned( obj ) | i;
+                osync_take( obj, me );
+                osync_unlock( &obj->lock );
+                return status;
+            }
+            osync_unlock( &obj->lock );
+        }
+        if (!deadline || (deadline != OSYNC_INFINITE && osync_now() >= deadline)) return OSYNC_CANCELLED;
+
+        block->tid = me;
+        block->count = count;
+        osync_store( &block->status, OSYNC_WAITING );
+        for (i = 0, linked = 0; i < total; i++)
+        {
+            struct osync_entry *entry = &block->entries[i];
+            struct osync_obj *obj = osync_obj( base, i < count ? cells[i] : alert );
+
+            entry->obj = i < count ? cells[i] : alert;
+            entry->slot = i;
+            entry->flags = 0;
+            osync_lock( &obj->lock, me );
+            if (osync_load( &block->status ) != OSYNC_WAITING)
+            {
+                osync_unlock( &obj->lock );
+                break;  /* claimed through an earlier object */
+            }
+            if (osync_can_take( obj, me ))
+            {
+                if (osync_claim( block, OSYNC_SIGNALED | osync_abandoned( obj ) | i )) osync_take( obj, me );
+                osync_unlock( &obj->lock );
+                break;
+            }
+            osync_link( base, obj, entry );
+            osync_unlock( &obj->lock );
+            linked++;
+        }
+
+        status = osync_sleep( block, deadline, total == 1 ? osync_obj( base, cells[0] ) : NULL );
+
+        for (i = 0; i < linked; i++)
+        {
+            struct osync_entry *entry = &block->entries[i];
+            struct osync_obj *obj = osync_obj( base, entry->obj );
+            if (!osync_linked( entry )) continue;
+            osync_lock( &obj->lock, me );
+            osync_unlink( base, obj, entry );
+            osync_unlock( &obj->lock );
+        }
+        if (!(status & OSYNC_RETRY))
+        {
+            osync_store( &block->status, OSYNC_IDLE );
+            return status;
+        }
+
+        /* The status stays OSYNC_RETRY until the attempt is over: if this thread dies before taking the mutex,
+         * the server sees it and wakes the next waiter instead. */
+        i = status & OSYNC_SLOT_MASK;
+        status = osync_retry( base, me, i < count ? cells[i] : alert, i );
+        osync_store( &block->status, OSYNC_IDLE );
+        if (status) return status;
+        __atomic_add_fetch( &block->lost, 1, __ATOMIC_RELAXED );
+    }
+}
+
+static inline void osync_sort_cells( uint32_t *cells, uint32_t count )
+{
+    uint32_t i, j, tmp;
+    for (i = 1; i < count; i++)
+        for (j = i; j && cells[j - 1] > cells[j]; j--)
+        {
+            tmp = cells[j];
+            cells[j] = cells[j - 1];
+            cells[j - 1] = tmp;
+        }
+}
+
+static inline uint32_t osync_wait_all( void *base, uint32_t block_cell, uint32_t me, uint32_t count,
+                                       const uint32_t *cells, uint32_t alert, uint64_t deadline, int *invalid )
+{
+    struct osync_header *header = osync_header( base );
+    struct osync_block *block = osync_block( base, block_cell );
+    struct osync_obj *alert_obj = alert ? osync_obj( base, alert ) : NULL;
+    uint32_t sorted[OSYNC_MAX_ENTRIES], i, ok = 1, abandoned = 0, status;
+
+    for (i = 0; i < count; i++) sorted[i] = cells[i];
+    osync_sort_cells( sorted, count );
+    for (i = 1; i < count; i++)
+        if (sorted[i] == sorted[i - 1])
+        {
+            *invalid = 1;
+            return 0;
+        }
+    *invalid = 0;
+
+    osync_lock( &header->all_lock, me );
+    for (i = 0; i < count; i++) osync_lock( &osync_obj( base, sorted[i] )->lock, me );
+    if (alert_obj) osync_lock( &alert_obj->lock, me );
+
+    for (i = 0; i < count && ok; i++)
+    {
+        struct osync_obj *obj = osync_obj( base, cells[i] );
+        ok = osync_can_take( obj, me );
+        abandoned |= osync_abandoned( obj );
+    }
+    if (ok)
+    {
+        for (i = 0; i < count; i++) osync_take( osync_obj( base, cells[i] ), me );
+        status = OSYNC_SIGNALED | abandoned;
+    }
+    else if (alert_obj && osync_can_take( alert_obj, me ))
+    {
+        osync_take( alert_obj, me );
+        status = OSYNC_SIGNALED | count;
+    }
+    else if (!deadline) status = OSYNC_CANCELLED;
+    else
+    {
+        block->tid = me;
+        block->count = count;
+        osync_store( &block->status, OSYNC_WAITING );
+        for (i = 0; i < count; i++)
+        {
+            struct osync_entry *entry = &block->entries[i];
+            entry->obj = cells[i];
+            entry->slot = i;
+            entry->flags = OSYNC_ENTRY_ALL;
+            osync_link( base, osync_obj( base, cells[i] ), entry );
+        }
+        if (alert_obj)
+        {
+            struct osync_entry *entry = &block->entries[count];
+            entry->obj = alert;
+            entry->slot = count;
+            entry->flags = 0;
+            osync_link( base, alert_obj, entry );
+        }
+        status = OSYNC_WAITING;
+    }
+
+    if (alert_obj) osync_unlock( &alert_obj->lock );
+    for (i = 0; i < count; i++) osync_unlock( &osync_obj( base, sorted[i] )->lock );
+    osync_unlock( &header->all_lock );
+    if (status != OSYNC_WAITING) return status;
+
+    status = osync_sleep( block, deadline, NULL );
+
+    for (i = 0; i < count + (alert_obj ? 1 : 0); i++)
+    {
+        struct osync_entry *entry = &block->entries[i];
+        struct osync_obj *obj = osync_obj( base, entry->obj );
+        if (!osync_linked( entry )) continue;
+        osync_lock( &obj->lock, me );
+        osync_unlink( base, obj, entry );
+        osync_unlock( &obj->lock );
+    }
+    osync_store( &block->status, OSYNC_IDLE );
+    return status;
+}
+
+#endif /* __APPLE__ */
+
+#endif /* __WINE_WINE_OSYNC_H */
