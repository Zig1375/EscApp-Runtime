new file mode 100644
index 0000000..72ca074
--- /dev/null
+++ b/server/osync.c
@@ -0,0 +1,370 @@
+/*
+ * osync: in-process synchronization objects on macOS, server side
+ *
+ * Copyright 2026 EscApp contributors
+ *
