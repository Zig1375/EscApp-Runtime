+static BOOL is_pseudo_handle( HANDLE handle )
+{
+    return ((ULONG)(ULONG_PTR)handle >= 0xfffffffa);
+}
+
+#ifdef __APPLE__
+
+/* osync: an object is a name in a region shared with the server, not an fd, so there is nothing to close and the
+ * cache needs no reference counts. An entry is one 64-bit value (name, access rights, type) read and written
+ * whole; a thread killed in the middle of a call holds nothing. A name gone stale (its handle closed and the value
+ * given to another object) fails osync's generation check and is fetched again. */
+
+#define OSYNC_CACHE_BLOCK_SIZE  (65536 / sizeof(uint64_t))
+#define OSYNC_CACHE_ENTRIES     128
+
+static uint64_t *osync_cache[OSYNC_CACHE_ENTRIES];
+
+static uint64_t *osync_cache_slot( HANDLE handle, BOOL alloc )
+{
+    unsigned int idx = (wine_server_obj_handle(handle) >> 2) - 1;
+    unsigned int entry = idx / OSYNC_CACHE_BLOCK_SIZE;
+
+    if (is_pseudo_handle( handle ) || entry >= OSYNC_CACHE_ENTRIES) return NULL;
+    if (!osync_cache[entry])
+    {
+        void *ptr;
+        if (!alloc) return NULL;
+        ptr = anon_mmap_alloc( OSYNC_CACHE_BLOCK_SIZE * sizeof(uint64_t), PROT_READ | PROT_WRITE );
+        if (ptr == MAP_FAILED) return NULL;
+        osync_cache[entry] = ptr;  /* under fd_cache_mutex */
+    }
+    return &osync_cache[entry][idx % OSYNC_CACHE_BLOCK_SIZE];
+}
+
+/* granted access never has the generic bits (28-31) set: the type goes there */
+static uint64_t osync_cache_pack( const struct inproc_sync *sync )
+{
+    return (uint64_t)(sync->access | (unsigned int)sync->type << 28) << 32 | (unsigned int)sync->fd;
+}
+
+static void release_inproc_sync( struct inproc_sync *sync )
+{
+    /* always a copy on the caller's stack */
+}
