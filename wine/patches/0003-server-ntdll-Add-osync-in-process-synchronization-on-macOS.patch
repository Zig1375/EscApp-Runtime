+/* osync (include/wine/osync.h): objects live in a region shared with the server and the other processes;
+ * "fds" are object names in it. */
+
+static void *osync_base;
+
+static int get_inproc_alert_fd(void);
+
+int osync_client_init( int fd )
+{
+    void *base = mmap( NULL, OSYNC_REGION_SIZE, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0 );
+
+    if (base == MAP_FAILED) return -1;
+    if (osync_header( base )->magic != OSYNC_MAGIC || osync_header( base )->version != OSYNC_VERSION)
+    {
+        munmap( base, OSYNC_REGION_SIZE );
+        return -1;
+    }
+    osync_base = base;
+    return 0;
+}
+
+static NTSTATUS osync_status( enum osync_result result )
+{
+    switch (result)
+    {
+    case OSYNC_OK: return STATUS_SUCCESS;
+    case OSYNC_BAD_HANDLE: return STATUS_INVALID_HANDLE;
+    case OSYNC_LIMIT: return STATUS_SEMAPHORE_LIMIT_EXCEEDED;
+    case OSYNC_NOT_OWNED: return STATUS_MUTANT_NOT_OWNED;
+    }
+    return STATUS_INTERNAL_ERROR;
+}
+
+static NTSTATUS linux_release_semaphore_obj( int obj, ULONG count, ULONG *prev_count )
+{
+    uint32_t prev;
+    NTSTATUS ret = osync_status( osync_release_semaphore( osync_base, obj, count, GetCurrentThreadId(), &prev ) );
+    if (!ret && prev_count) *prev_count = prev;
+    return ret;
+}
+
+static NTSTATUS linux_query_semaphore_obj( int obj, SEMAPHORE_BASIC_INFORMATION *info )
+{
+    struct osync_obj copy;
+    NTSTATUS ret = osync_status( osync_read( osync_base, obj, GetCurrentThreadId(), &copy ) );
+    if (ret) return ret;
+    info->CurrentCount = copy.state;
+    info->MaximumCount = copy.max;
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS osync_event( int obj, int op, LONG *prev_state )
+{
+    uint32_t prev;
+    NTSTATUS ret = osync_status( osync_event_op( osync_base, obj, op, GetCurrentThreadId(), &prev ) );
+    if (!ret && prev_state) *prev_state = prev;
+    return ret;
+}
+
+static NTSTATUS linux_set_event_obj( int obj, LONG *prev_state )
+{
+    return osync_event( obj, 0, prev_state );
+}
+
+static NTSTATUS linux_reset_event_obj( int obj, LONG *prev_state )
+{
+    return osync_event( obj, 1, prev_state );
+}
+
+static NTSTATUS linux_pulse_event_obj( int obj, LONG *prev_state )
+{
+    return osync_event( obj, 2, prev_state );
+}
+
+static NTSTATUS linux_query_event_obj( int obj, EVENT_BASIC_INFORMATION *info )
+{
+    struct osync_obj copy;
+    NTSTATUS ret = osync_status( osync_read( osync_base, obj, GetCurrentThreadId(), &copy ) );
+    if (ret) return ret;
+    info->EventType = copy.type == OSYNC_EVENT_MANUAL ? NotificationEvent : SynchronizationEvent;
+    info->EventState = copy.state;
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS linux_release_mutex_obj( int obj, LONG *prev_count )
+{
+    uint32_t prev;
+    enum osync_result result = osync_release_mutex( osync_base, obj, GetCurrentThreadId(), &prev );
+    if (result == OSYNC_NOT_OWNED) return STATUS_MUTANT_NOT_OWNED;
+    if (result) return osync_status( result );
+    if (prev_count) *prev_count = 1 - prev;
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS linux_query_mutex_obj( int obj, MUTANT_BASIC_INFORMATION *info )
+{
+    struct osync_obj copy;
+    NTSTATUS ret = osync_status( osync_read( osync_base, obj, GetCurrentThreadId(), &copy ) );
+    if (ret) return ret;
+    info->AbandonedState = copy.abandoned;
+    info->OwnedByCaller = copy.owner && copy.owner == GetCurrentThreadId();
+    info->CurrentCount = 1 - (LONG)copy.state;
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS linux_wait_objs( int device, DWORD count, const int *objs, WAIT_TYPE type,
+                                 int alert_fd, const LARGE_INTEGER *timeout )
+{
+    uint32_t cells[OSYNC_MAX_ENTRIES], alert_name, block, status, i, slot, me = GetCurrentThreadId();
+    uint64_t deadline;
+    int invalid;
+
+    for (i = 0; i < count; i++)
+    {
+        struct osync_obj *obj = osync_lookup( osync_base, objs[i] );
+        if (!obj || !osync_valid( obj, objs[i] )) return STATUS_INVALID_HANDLE;
+        cells[i] = objs[i] & OSYNC_CELL_MASK;
+    }
+    /* the thread's wait block is published in its alert event */
+    if ((int)(alert_name = get_inproc_alert_fd()) < 0) return STATUS_NOT_IMPLEMENTED;
+    block = osync_obj( osync_base, alert_name & OSYNC_CELL_MASK )->aux;
+
+    if (!timeout || timeout->QuadPart == TIMEOUT_INFINITE) deadline = OSYNC_INFINITE;
+    else
+    {
+        LONGLONG rel = timeout->QuadPart;
+        if (rel > 0)  /* absolute, in 100ns units since 1601 */
+        {
+            struct timespec now;
+            clock_gettime( CLOCK_REALTIME, &now );
+            rel = (now.tv_sec + SECS_1601_TO_1970) * TICKSPERSEC + now.tv_nsec / 100 - rel;
+            if (rel > 0) rel = 0;
+        }
+        deadline = rel ? osync_now() + (uint64_t)-rel * 100 : 0;
+    }
+
+    if (type == WaitAll && count > 1)
+    {
+        status = osync_wait_all( osync_base, block, me, count, cells, alert_fd ? alert_name & OSYNC_CELL_MASK : 0,
+                                 deadline, &invalid );
+        if (invalid) return STATUS_INVALID_PARAMETER;
+    }
+    else status = osync_wait_any( osync_base, block, me, count, cells, alert_fd ? alert_name & OSYNC_CELL_MASK : 0,
+                                  deadline );
+
+    if (status == OSYNC_CANCELLED) return STATUS_TIMEOUT;
+    slot = status & OSYNC_SLOT_MASK;
+    if (slot == count)
+    {
+        static const LARGE_INTEGER zero;
+        NTSTATUS ret = server_wait( NULL, 0, SELECT_INTERRUPTIBLE | SELECT_ALERTABLE, &zero );
+        assert( ret == STATUS_USER_APC );
+        return ret;
+    }
+    if (type == WaitAll) slot = 0;
+    if (status & OSYNC_ABANDONED) return STATUS_ABANDONED + slot;
+    return slot;
+}
+
