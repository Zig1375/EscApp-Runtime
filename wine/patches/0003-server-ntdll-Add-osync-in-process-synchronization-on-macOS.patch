+/* fills "stack" and returns it */
+static NTSTATUS get_inproc_sync( HANDLE handle, enum inproc_sync_type desired_type, ACCESS_MASK desired_access,
+                                 struct inproc_sync *stack, struct inproc_sync **out )
+{
+    uint64_t *slot = osync_cache_slot( handle, FALSE ), value = slot ? __atomic_load_n( slot, __ATOMIC_ACQUIRE ) : 0;
+    struct osync_obj *obj;
+    sigset_t sigset;
+    NTSTATUS ret;
+
+    if (value && (!(obj = osync_lookup( osync_base, (uint32_t)value )) || !osync_valid( obj, (uint32_t)value )))
+        value = 0;  /* stale */
+    if (value)
+    {
+        stack->fd = (uint32_t)value;
+        stack->access = (value >> 32) & 0x0fffffff;
+        stack->type = value >> 60;
+    }
+    else
+    {
+        /* fd_cache_mutex orders this with NtClose, so that a closed handle's object is never stored after
+         * close_inproc_sync() cleared its entry */
+        server_enter_uninterrupted_section( &fd_cache_mutex, &sigset );
+        if ((ret = get_server_inproc_sync( handle, stack )))
+        {
+            server_leave_uninterrupted_section( &fd_cache_mutex, &sigset );
+            return ret;
+        }
+        if (!(stack->access & 0xf0000000) && (slot = osync_cache_slot( handle, TRUE )))
+            __atomic_store_n( slot, osync_cache_pack( stack ), __ATOMIC_RELEASE );
+        server_leave_uninterrupted_section( &fd_cache_mutex, &sigset );
+    }
+    stack->refcount = 1;
+    stack->closed = 0;
+
+    if (desired_type != INPROC_SYNC_UNKNOWN && desired_type != stack->type) return STATUS_OBJECT_TYPE_MISMATCH;
+    if ((stack->access & desired_access) != desired_access) return STATUS_ACCESS_DENIED;
+    *out = stack;
+    return STATUS_SUCCESS;
+}
