+/* Windows keeps the permissions a program gives a file or folder (SetNamedSecurityInfo) with it. Wine turned them
+ * into the Unix mode and built them again from that mode, so whoever had been given access was gone the next time
+ * the file was opened: the Epic Games Launcher grants the players' group access to a game's folder from a second
+ * copy of itself, then looks for that grant and stopped the install with error DP-07. The security descriptor set
+ * last is kept in an extended attribute, with the Unix mode it was set with; once the mode has changed outside
+ * Wine it no longer describes the file and is ignored. */
+#define XATTR_SD XATTR_USER_PREFIX "wine.sd"
+#define STORED_SD_VERSION 1
+#define STORED_SD_MAX_SIZE 65536
+
+struct stored_sd
+{
+    unsigned int version;
+    unsigned int mode;  /* S_IRWXU|S_IRWXG|S_IRWXO of the file when it was stored */
+};
+
+void store_unix_fd_sd( int unix_fd, const struct security_descriptor *sd, mode_t mode )
+{
+    data_size_t size = sizeof(*sd) + sd->owner_len + sd->group_len + sd->sacl_len + sd->dacl_len;
+    struct stored_sd *stored;
+
+    if (sizeof(*stored) + size > STORED_SD_MAX_SIZE || !(stored = malloc( sizeof(*stored) + size ))) return;
+    stored->version = STORED_SD_VERSION;
+    stored->mode = mode & (S_IRWXU|S_IRWXG|S_IRWXO);
+    memcpy( stored + 1, sd, size );
+    xattr_fset( unix_fd, XATTR_SD, stored, sizeof(*stored) + size );
+    free( stored );
+}
+
+/* Windows maps generic rights (GENERIC_ALL) to the file's own when permissions are set, and programs look for
+ * those (FILE_ALL_ACCESS for GENERIC_ALL, which the Epic Games Launcher grants). Entries that only pass to what
+ * is created inside (INHERIT_ONLY_ACE) keep them, as on Windows. */
+struct security_descriptor *map_sd_generic_access( struct object *obj, const struct security_descriptor *sd )
+{
+    data_size_t size = sizeof(*sd) + sd->owner_len + sd->group_len + sd->sacl_len + sd->dacl_len;
+    struct security_descriptor *mapped;
+    const struct acl *dacl;
+    struct ace *ace;
+    unsigned int i;
+    int present;
+
+    if (!(mapped = malloc( size ))) return NULL;
+    memcpy( mapped, sd, size );
+    if (!(dacl = sd_get_dacl( mapped, &present )) || !present) return mapped;
+    for (i = 0, ace = (struct ace *)(dacl + 1); i < dacl->count; i++, ace = ace_next( ace ))
+        if (!(ace->flags & INHERIT_ONLY_ACE)) ace->mask = map_obj_access( obj, ace->mask );
+    return mapped;
+}
+
+struct security_descriptor *load_unix_fd_sd( int unix_fd, mode_t mode )
+{
+    struct security_descriptor *sd = NULL;
+    struct stored_sd *stored;
+    int size = xattr_fget( unix_fd, XATTR_SD, NULL, 0 );
+
+    if (size <= (int)sizeof(*stored) || size > STORED_SD_MAX_SIZE) return NULL;
+    if (!(stored = malloc( size ))) return NULL;
+    if (xattr_fget( unix_fd, XATTR_SD, stored, size ) == size &&
+        stored->version == STORED_SD_VERSION &&
+        stored->mode == (mode & (S_IRWXU|S_IRWXG|S_IRWXO)) &&
+        sd_is_valid( (struct security_descriptor *)(stored + 1), size - sizeof(*stored) ) &&
+        (sd = malloc( size - sizeof(*stored) )))
+        memcpy( sd, stored + 1, size - sizeof(*stored) );
+    free( stored );
+    return sd;
+}
+
