+#elif defined(__APPLE__)
+
+/* FSEvents support
+ *
+ * macOS has no inotify, so ReadDirectoryChangesW used to wait forever. The Epic Games Launcher prepares a game's
+ * install folder in a second, elevated copy of itself, which reports back by writing a file into a folder the
+ * launcher watches; the launcher never heard of it and gave the install up after 50 seconds (error DP-06).
+ *
+ * Each watching directory gets a stream of its own (fsevents.c). FSEvents always watches the whole tree and gives
+ * full paths, so a watch without subtree drops what happens below its own entries.
+ *
+ * FSEvents' flags pile up: a file created a few seconds ago comes as "created" with every later write, a renamed
+ * one as "renamed", and one removed soon after its creation as created and removed. Whether the item still exists
+ * decides whether it went away, and each watch remembers the items (name and inode) it has announced, so that a
+ * write into a new file is a modification, not the file being added again. */
+
+#define MAX_KNOWN 1024  /* items announced per watch that are remembered; beyond, the oldest may be announced again */
+
+struct known_item
+{
+    struct list entry;
+    ino_t       ino;
+    char        name[1];
+};
+
+static struct fd *fsevents_fd;
+static unsigned int last_watch_id;
+static unsigned int last_cookie;
+
+static int fsevents_get_poll_events( struct fd *fd );
+static void fsevents_poll_event( struct fd *fd, int event );
+
+static const struct fd_ops fsevents_fd_ops =
+{
+    .get_poll_events = fsevents_get_poll_events,
+    .poll_event      = fsevents_poll_event,
+};
+
+static int fsevents_get_poll_events( struct fd *fd )
+{
+    return POLLIN;
+}
+
+static unsigned int new_cookie( void )
+{
+    if (!++last_cookie) ++last_cookie;  /* 0 means "paired" to read_change */
+    return last_cookie;
+}
+
+static struct dir *dir_from_watch( unsigned int id )
+{
+    struct dir *dir;
+
+    LIST_FOR_EACH_ENTRY( dir, &change_list, struct dir, entry )
+        if (dir->watch && dir->watch_id == id) return dir;
+    return NULL;
+}
+
+static void fsevents_do_change_notify( struct dir *dir, unsigned int filter, unsigned int action,
+                                       unsigned int cookie, const char *relpath )
+{
+    struct change_record *record;
+
+    if (!(filter & dir->filter)) return;
+
+    if (dir->want_data)
+    {
+        size_t len = strlen( relpath );
+        if (!(record = malloc( offsetof( struct change_record, event.name[len] ) ))) return;
+        record->cookie = cookie;
+        record->event.action = action;
+        memcpy( record->event.name, relpath, len );
+        record->event.len = len;
+        list_add_tail( &dir->change_records, &record->entry );
+    }
+
+    fd_async_wake_up( dir->fd, ASYNC_TYPE_WAIT, STATUS_ALERTED );
+}
+
+static struct known_item *find_known( struct dir *dir, const char *name )
+{
+    struct known_item *item;
+
+    LIST_FOR_EACH_ENTRY( item, &dir->known, struct known_item, entry )
+        if (!strcmp( item->name, name )) return item;
+    return NULL;
+}
+
+static void forget_known( struct dir *dir, struct known_item *item )
+{
+    list_remove( &item->entry );
+    dir->known_count--;
+    free( item );
+}
+
+static void add_known( struct dir *dir, const char *name, ino_t ino )
+{
+    struct known_item *item;
+    size_t len = strlen( name );
+
+    if ((item = find_known( dir, name ))) forget_known( dir, item );
+    if (dir->known_count == MAX_KNOWN)
+        forget_known( dir, LIST_ENTRY( list_tail( &dir->known ), struct known_item, entry ) );
+    if (!(item = malloc( offsetof( struct known_item, name[len + 1] ) ))) return;
+    item->ino = ino;
+    memcpy( item->name, name, len + 1 );
+    list_add_head( &dir->known, &item->entry );
+    dir->known_count++;
+}
+
+/* renamed_watch and renamed_cookie pair a rename's old name with the new name that follows it in the same batch */
+static void fsevents_handle( const struct fsevent *event, unsigned int *renamed_watch, unsigned int *renamed_cookie )
+{
+    unsigned int name_filter, filter = 0, cookie;
+    struct known_item *item;
+    struct dir *dir;
+    const char *relpath;
+    struct stat st;
+    size_t len;
+    int exists, known;
+
+    if (!(dir = dir_from_watch( event->watch ))) return;  /* closed meanwhile */
+
+    cookie = *renamed_watch == event->watch ? *renamed_cookie : 0;
+    *renamed_cookie = 0;
+
+    if (event->flags & FSE_RESCAN)
+    {
+        /* woken without data, the program is told to read the directory again (STATUS_NOTIFY_ENUM_DIR) */
+        fd_async_wake_up( dir->fd, ASYNC_TYPE_WAIT, STATUS_ALERTED );
+        return;
+    }
+
+    len = strlen( dir->watch_path );
+    if (strncmp( event->path, dir->watch_path, len ) || event->path[len] != '/' || !event->path[len + 1]) return;
+    relpath = event->path + len + 1;
+    if (!dir->subtree && strchr( relpath, '/' )) return;
+
+    exists = !lstat( event->path, &st );
+    if (exists ? S_ISDIR( st.st_mode ) : (event->flags & FSE_DIR) != 0)
+        name_filter = FILE_NOTIFY_CHANGE_DIR_NAME;
+    else
+        name_filter = FILE_NOTIFY_CHANGE_FILE_NAME;
+
+    item = find_known( dir, relpath );
+    if (!exists)
+    {
+        /* gone before it was announced: it came and went in one report */
+        if (!item && (event->flags & FSE_CREATED))
+            fsevents_do_change_notify( dir, name_filter | FILE_NOTIFY_CHANGE_CREATION, FILE_ACTION_ADDED, 0,
+                                       relpath );
+        if (item) forget_known( dir, item );
+        if (event->flags & FSE_REMOVED)
+            fsevents_do_change_notify( dir, name_filter, FILE_ACTION_REMOVED, 0, relpath );
+        else if (event->flags & FSE_RENAMED)
+        {
+            *renamed_watch = event->watch;
+            *renamed_cookie = new_cookie();
+            fsevents_do_change_notify( dir, name_filter, FILE_ACTION_RENAMED_OLD_NAME, *renamed_cookie, relpath );
+        }
+        return;
+    }
+    known = item && item->ino == st.st_ino;
+
+    if ((event->flags & FSE_RENAMED) && !known)
+    {
+        /* a new name without its old one in this tree comes from outside: read_change makes it "added" */
+        add_known( dir, relpath, st.st_ino );
+        fsevents_do_change_notify( dir, name_filter, FILE_ACTION_RENAMED_NEW_NAME, cookie ? cookie : new_cookie(),
+                                   relpath );
+        return;
+    }
+    if ((event->flags & FSE_CREATED) && !known)
+    {
+        add_known( dir, relpath, st.st_ino );
+        fsevents_do_change_notify( dir, name_filter | FILE_NOTIFY_CHANGE_CREATION, FILE_ACTION_ADDED, 0, relpath );
+        /* creating an item sets its times and may truncate it; only data written into a new file is a change */
+        if (!S_ISREG( st.st_mode ) || !st.st_size) return;
+    }
+
+    if (event->flags & FSE_MODIFIED)
+        filter |= FILE_NOTIFY_CHANGE_SIZE | FILE_NOTIFY_CHANGE_LAST_WRITE | FILE_NOTIFY_CHANGE_LAST_ACCESS;
+    if (event->flags & FSE_ATTRIB)  /* this includes changed times */
+        filter |= FILE_NOTIFY_CHANGE_ATTRIBUTES | FILE_NOTIFY_CHANGE_SECURITY | FILE_NOTIFY_CHANGE_LAST_WRITE;
+    if (filter) fsevents_do_change_notify( dir, filter, FILE_ACTION_MODIFIED, 0, relpath );
+}
+
+static void fsevents_poll_event( struct fd *fd, int event )
+{
+    unsigned int renamed_watch = 0, renamed_cookie = 0;
+    struct fsevent *fse, *next;
+
+    for (fse = fsevents_take(); fse; fse = next)
+    {
+        next = fse->next;
+        fsevents_handle( fse, &renamed_watch, &renamed_cookie );
+        free( fse );
+    }
+}
+
+static int init_inotify( void )
+{
+    int unix_fd;
+
+    if (fsevents_fd) return 1;
+    if ((unix_fd = fsevents_init()) == -1) return 0;
+    if (!(fsevents_fd = create_anonymous_fd( &fsevents_fd_ops, unix_fd, NULL, 0 ))) return 0;
+    set_fd_events( fsevents_fd, POLLIN );
+    return 1;
+}
+
+static int inotify_adjust_changes( struct dir *dir )
+{
+    char path[PATH_MAX];
+    size_t len;
+
+    if (!fsevents_fd) return 0;
+    if (dir->watch) return 1;  /* the stream watches everything; the filter is applied to its events */
+
+    if (fcntl( get_unix_fd( dir->fd ), F_GETPATH, path ) == -1) return 0;
+    len = strlen( path );
+    while (len > 1 && path[len - 1] == '/') path[--len] = 0;
+    if (!(dir->watch_path = strdup( path ))) return 0;
+
+    dir->watch_id = ++last_watch_id;
+    if (!(dir->watch = fsevents_watch( path, dir->watch_id )))
+    {
+        free( dir->watch_path );
+        dir->watch_path = NULL;
+        return 0;
+    }
+    return 1;
+}
+
+static void dir_remove_watch( struct dir *dir )
+{
+    struct known_item *item, *next;
+
+    if (dir->watch) fsevents_unwatch( dir->watch );
+    LIST_FOR_EACH_ENTRY_SAFE( item, next, &dir->known, struct known_item, entry ) forget_known( dir, item );
+    free( dir->watch_path );
+    dir->watch = NULL;
+    dir->watch_path = NULL;
+}
+
+static void free_inode( struct inode *inode )
+{
+    assert( 0 );
+}
+
+static void dir_add_to_existing_notify( struct dir *dir )
+{
+}
+
 #else
 
 static int init_inotify( void )
@@ -1108,6 +1377,10 @@ static int inotify_adjust_changes( struct dir *dir )
     return 0;
 }
 
+static void dir_remove_watch( struct dir *dir )
+{
+}
+
 static void free_inode( struct inode *inode )
 {
     assert( 0 );
@@ -1133,6 +1406,12 @@ struct object *create_dir_obj( struct fd *fd, unsigned int access, mode_t mode )
     dir->notified = 0;
     dir->want_data = 0;
     dir->inode = NULL;
+#if !defined(HAVE_SYS_INOTIFY_H) && defined(__APPLE__)
+    dir->watch = NULL;
+    dir->watch_path = NULL;
+    list_init( &dir->known );
+    dir->known_count = 0;
+#endif
     grab_object( fd );
     dir->fd = fd;
     dir->mode = mode;
