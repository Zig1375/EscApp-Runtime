new file mode 100644
index 0000000..3658ba6
--- /dev/null
+++ b/server/fsevents.c
@@ -0,0 +1,175 @@
+/*
+ * Directory change notifications through FSEvents (macOS)
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#ifdef __APPLE__
+
+#include <errno.h>
+#include <fcntl.h>
+#include <pthread.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <CoreServices/CoreServices.h>
+
+#include "fsevents.h"
+
+/* FSEvents calls back on a dispatch queue, on a thread of its own, while the rest of wineserver is single-threaded.
+ * The callback therefore only copies the events into a list under a lock and writes a byte to a pipe that the
+ * server's poll loop watches; change.c then matches them to the directories on the server thread. */
+
+static dispatch_queue_t queue;
+static pthread_mutex_t lock = PTHREAD_MUTEX_INITIALIZER;
+static struct fsevent *head, **tail = &head;
+static int wake[2] = { -1, -1 };
+
+struct watch
+{
+    FSEventStreamRef stream;
+};
+
+static unsigned int translate_flags( FSEventStreamEventFlags flags )
+{
+    unsigned int ret = 0;
+
+    if (flags & (kFSEventStreamEventFlagMustScanSubDirs | kFSEventStreamEventFlagUserDropped |
+                 kFSEventStreamEventFlagKernelDropped))
+        ret |= FSE_RESCAN;
+    if (flags & kFSEventStreamEventFlagItemCreated) ret |= FSE_CREATED;
+    if (flags & kFSEventStreamEventFlagItemRemoved) ret |= FSE_REMOVED;
+    if (flags & kFSEventStreamEventFlagItemRenamed) ret |= FSE_RENAMED;
+    if (flags & kFSEventStreamEventFlagItemModified) ret |= FSE_MODIFIED;
+    if (flags & (kFSEventStreamEventFlagItemInodeMetaMod | kFSEventStreamEventFlagItemChangeOwner |
+                 kFSEventStreamEventFlagItemXattrMod | kFSEventStreamEventFlagItemFinderInfoMod))
+        ret |= FSE_ATTRIB;
+    if (flags & kFSEventStreamEventFlagItemIsDir) ret |= FSE_DIR;
+    return ret;
+}
+
+static void callback( ConstFSEventStreamRef stream, void *info, size_t count, void *paths,
+                      const FSEventStreamEventFlags flags[], const FSEventStreamEventId ids[] )
+{
+    unsigned int id = (uintptr_t)info;
+    struct fsevent *first = NULL, **last = &first;
+    char **names = paths;
+    size_t i, len;
+
+    for (i = 0; i < count; i++)
+    {
+        unsigned int fse = translate_flags( flags[i] );
+        struct fsevent *event;
+
+        if (!fse) continue;
+        len = strlen( names[i] );
+        if (!(event = malloc( offsetof( struct fsevent, path[len + 1] ) ))) continue;
+        event->next = NULL;
+        event->watch = id;
+        event->flags = fse;
+        memcpy( event->path, names[i], len + 1 );
+        *last = event;
+        last = &event->next;
+    }
+    if (!first) return;
+
+    /* one batch stays together, so a rename's old and new name arrive next to each other */
+    pthread_mutex_lock( &lock );
+    *tail = first;
+    tail = last;
+    pthread_mutex_unlock( &lock );
+    /* the pipe is non-blocking: when it is full, a wake-up is pending anyway */
+    write( wake[1], "", 1 );
+}
+
+int fsevents_init( void )
+{
+    if (wake[0] != -1) return wake[0];
+    if (pipe( wake ) == -1) return -1;
+    fcntl( wake[0], F_SETFL, O_NONBLOCK );
+    fcntl( wake[1], F_SETFL, O_NONBLOCK );
+    fcntl( wake[0], F_SETFD, FD_CLOEXEC );
+    fcntl( wake[1], F_SETFD, FD_CLOEXEC );
+    queue = dispatch_queue_create( "org.winehq.wineserver.fsevents", DISPATCH_QUEUE_SERIAL );
+    return wake[0];
+}
+
+void *fsevents_watch( const char *path, unsigned int id )
+{
+    FSEventStreamContext context = { 0, (void *)(uintptr_t)id, NULL, NULL, NULL };
+    CFStringRef string;
+    CFArrayRef array;
+    struct watch *watch;
+
+    if (!queue || !(watch = malloc( sizeof(*watch) ))) return NULL;
+    string = CFStringCreateWithFileSystemRepresentation( NULL, path );
+    array = string ? CFArrayCreate( NULL, (const void **)&string, 1, &kCFTypeArrayCallBacks ) : NULL;
+    /* file events: one event per item with its own path, not one per directory; no defer: the first change of a
+       quiet period is delivered at once, then at most every 10 ms */
+    watch->stream = array ? FSEventStreamCreate( NULL, callback, &context, array, kFSEventStreamEventIdSinceNow,
+                                                 0.01, kFSEventStreamCreateFlagFileEvents |
+                                                 kFSEventStreamCreateFlagNoDefer ) : NULL;
+    if (array) CFRelease( array );
+    if (string) CFRelease( string );
+    if (!watch->stream)
+    {
+        free( watch );
+        return NULL;
+    }
+    FSEventStreamSetDispatchQueue( watch->stream, queue );
+    if (!FSEventStreamStart( watch->stream ))
+    {
+        FSEventStreamInvalidate( watch->stream );
+        FSEventStreamRelease( watch->stream );
+        free( watch );
+        return NULL;
+    }
+    return watch;
+}
+
+static void stop_stream( void *arg )
+{
+    FSEventStreamRef stream = arg;
+
+    FSEventStreamStop( stream );
+    FSEventStreamInvalidate( stream );
+    FSEventStreamRelease( stream );
+}
+
+void fsevents_unwatch( void *arg )
+{
+    struct watch *watch = arg;
+
+    /* on the stream's own queue, so that no callback of it is still running afterwards */
+    dispatch_sync_f( queue, watch->stream, stop_stream );
+    free( watch );
+}
+
+struct fsevent *fsevents_take( void )
+{
+    struct fsevent *ret;
+    char buffer[64];
+
+    while (read( wake[0], buffer, sizeof(buffer) ) > 0);
+    pthread_mutex_lock( &lock );
+    ret = head;
+    head = NULL;
+    tail = &head;
+    pthread_mutex_unlock( &lock );
+    return ret;
+}
+
+#endif /* __APPLE__ */
