index 0000000..54b3f94
--- /dev/null
+++ b/server/fsevents.h
@@ -0,0 +1,49 @@
+/*
+ * Directory change notifications through FSEvents (macOS)
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#ifndef __WINE_SERVER_FSEVENTS_H
+#define __WINE_SERVER_FSEVENTS_H
+
+/* Kept free of Wine's and Apple's headers: the two don't mix (BOOL, ULONG, ...), so change.c sees only this. */
+
+#define FSE_CREATED   0x01  /* an item appeared */
+#define FSE_REMOVED   0x02  /* an item went away */
+#define FSE_RENAMED   0x04  /* an item was renamed: the old or the new name, whichever this path is now */
+#define FSE_MODIFIED  0x08  /* a file's contents changed */
+#define FSE_ATTRIB    0x10  /* metadata changed: times, mode, owner, extended attributes */
+#define FSE_DIR       0x20  /* the item is a directory */
+#define FSE_RESCAN    0x40  /* events were dropped: everything below the watch may have changed */
+
+struct fsevent
+{
+    struct fsevent *next;
+    unsigned int    watch;  /* id given to fsevents_watch */
+    unsigned int    flags;  /* FSE_* */
+    char            path[1];
+};
+
+/* returns the read end of a pipe that becomes readable when events are queued, or -1 */
+extern int fsevents_init( void );
+/* starts watching the tree below path; events carry id */
+extern void *fsevents_watch( const char *path, unsigned int id );
+/* stops a watch; no event of it is queued afterwards */
+extern void fsevents_unwatch( void *watch );
+/* empties the wake-up pipe and returns the queued events, oldest first; free each with free() */
+extern struct fsevent *fsevents_take( void );
+
+#endif /* __WINE_SERVER_FSEVENTS_H */
